{% comment %} AI Step Ahead motion layer: scroll reveals, count-ups, hover lift. Content stays visible if JS is off. {% endcomment %}
<style>
  .aisa-rv{opacity:0;transform:translateY(28px);transition:opacity .9s cubic-bezier(.2,.8,.2,1),transform .9s cubic-bezier(.2,.8,.2,1);transition-delay:var(--rv-d,0ms);will-change:opacity,transform}
  .aisa-rv.aisa-in{opacity:1;transform:none}
  .aih .use-grid li,.aih .prin li,.cwg .cap-grid li,.cwg .parts li,.cwg .fit>div{transition:background .25s,transform .35s cubic-bezier(.2,.8,.2,1),box-shadow .35s}
  .aih .use-grid li:hover,.cwg .cap-grid li:hover{transform:translateY(-4px);box-shadow:0 22px 40px -28px rgba(80,45,20,.45);position:relative;z-index:1}
  .aih .feat-card,.cwg .offer-card,.cwg .panel.strong{transition:transform .5s cubic-bezier(.2,.8,.2,1),box-shadow .5s}
  .aih .feat-card:hover,.cwg .offer-card:hover{transform:translateY(-4px);box-shadow:0 50px 90px -50px rgba(80,45,20,.5)}
  .aih .btn,.cwg .btn{position:relative;overflow:hidden}
  .aih .btn::after,.cwg .btn::after{content:'';position:absolute;inset:0;background:linear-gradient(110deg,transparent 30%,rgba(255,255,255,.28) 50%,transparent 70%);transform:translateX(-120%);transition:transform .8s ease}
  .aih .btn:hover::after,.cwg .btn:hover::after{transform:translateX(120%)}
  .cwg .mini,.aih .mini{animation:aisaFloat 6s ease-in-out infinite}
  @keyframes aisaFloat{0%,100%{translate:0 0}50%{translate:0 -8px}}
  @media (prefers-reduced-motion:reduce){.aisa-rv{opacity:1!important;transform:none!important;transition:none!important}.cwg .mini,.aih .mini{animation:none}}
</style>
<script>
  (function () {
    if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (!('IntersectionObserver' in window)) return;
    var sel = [
      '.aih section .h2', '.aih section .sub', '.aih .stat', '.aih .points li', '.aih .feat-card',
      '.aih .use-grid li', '.aih .prin li', '.aih .notify h2', '.aih .more',
      '.cwg section .h2', '.cwg section .sub', '.cwg .facts>div', '.cwg .cap-grid li', '.cwg .cap-foot',
      '.cwg .stat', '.cwg .losses li', '.cwg .turn', '.cwg .readout', '.cwg .sliders', '.cwg .panel',
      '.cwg .also', '.cwg .vtable', '.cwg .ptable', '.cwg .parts li', '.cwg .offer-card', '.cwg .fit>div',
      '.cwg .faq', '.cwg .final h2'
    ].join(',');
    var els = Array.prototype.slice.call(document.querySelectorAll(sel));
    if (!els.length) return;
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        e.target.classList.add('aisa-in');
        io.unobserve(e.target);
        var b = e.target.querySelector && e.target.querySelector('b[data-aisa-count]');
        if (b) count(b);
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
    els.forEach(function (el) {
      var sibs = el.parentElement ? Array.prototype.indexOf.call(el.parentElement.children, el) : 0;
      el.style.setProperty('--rv-d', (Math.min(sibs, 6) * 80) + 'ms');
      el.classList.add('aisa-rv');
      io.observe(el);
    });
    document.querySelectorAll('.cwg .facts b, .cwg .stat b, .aih .stat b').forEach(function (b) {
      var m = b.textContent.trim().match(/^(\d+)(%?)$/);
      if (!m) return;
      b.setAttribute('data-aisa-count', m[1]);
      b.setAttribute('data-aisa-suffix', m[2]);
    });
    function count(b) {
      var end = +b.getAttribute('data-aisa-count'), suf = b.getAttribute('data-aisa-suffix') || '', t0 = null, dur = 1400;
      function step(t) {
        if (!t0) t0 = t;
        var p = Math.min((t - t0) / dur, 1), v = Math.round(end * (1 - Math.pow(1 - p, 3)));
        b.textContent = v + suf;
        if (p < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }
  })();
</script>
