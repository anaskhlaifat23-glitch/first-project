<script>
(function(){
var root=document.getElementById('cwg');if(!root)return;root.classList.add('js');
var cur=root.querySelector('#cwg-ro').textContent.replace(/[0-9., ]/g,'')||'$',price=39;
function f(n){return Math.round(n).toLocaleString('en-US')}
function q(id){return root.querySelector('#'+id)}
var m=q('cwg-m'),d=q('cwg-d'),r=q('cwg-r');
function fill(i){i.style.setProperty('--p',((i.value-i.min)/(i.max-i.min)*100)+'%')}
function calc(){[m,d,r].forEach(fill);var h=m.value*d.value/60,mins=price/r.value*60;
q('cwg-mo').textContent=m.value+' min';q('cwg-do').textContent=d.value;q('cwg-ro').textContent=cur+r.value;
q('cwg-h').textContent=f(h);var wd=Math.round(h/8);q('cwg-wd').textContent=wd+(wd===1?' working day':' working days');
q('cwg-v').textContent=cur+f(h*r.value);q('cwg-pm').textContent=mins<90?f(mins)+' minutes':(mins/60).toFixed(1)+' hours'}
[m,d,r].forEach(function(i){i.addEventListener('input',calc)});calc();
var reduce=window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches;
var demo=q('cwg-demo');
if(demo&&!reduce&&'IntersectionObserver' in window){
var panels=demo.querySelectorAll('.panel');panels.forEach(function(p){p.classList.add('typing')});
var tp=demo.querySelector('[data-type]'),full=tp.textContent,lines=demo.querySelectorAll('[data-lines]>div');
tp.textContent='';lines.forEach(function(l){l.style.opacity=0;l.style.transform='translateX(-8px)';l.style.transition='opacity .4s,transform .4s'});
var io=new IntersectionObserver(function(es){if(!es[0].isIntersecting)return;io.disconnect();var i=0;tp.classList.add('caret');
(function t(){tp.textContent=full.slice(0,++i);if(i<full.length)setTimeout(t,28);else{tp.classList.remove('caret');panels[0].classList.remove('typing');
lines.forEach(function(l,k){setTimeout(function(){l.style.opacity=1;l.style.transform='none';if(k===lines.length-1)setTimeout(function(){panels[1].classList.remove('typing')},450)},300+k*260)})}})()},{threshold:.35});
io.observe(demo)}
var lb=q('cwg-lb');
if(lb&&typeof lb.showModal==='function'){var li=lb.querySelector('img'),lc=lb.querySelector('p');
root.querySelectorAll('.look-strip button').forEach(function(b){b.addEventListener('click',function(){li.src=b.getAttribute('data-full');li.alt=b.getAttribute('data-cap');lc.textContent=b.getAttribute('data-cap');lb.showModal()})});
lb.querySelector('button').addEventListener('click',function(){lb.close()});
lb.addEventListener('click',function(e){if(e.target===lb)lb.close()})}
else{root.querySelectorAll('.look-strip button').forEach(function(b){b.addEventListener('click',function(){window.open(b.getAttribute('data-full'),'_blank')})})}
var bar=q('cwg-bar'),top=q('cwg-top'),fin=q('cwg-final'),offTop=false,atEnd=false;
function upd(){bar.classList.toggle('on',offTop&&!atEnd)}
if('IntersectionObserver' in window){
new IntersectionObserver(function(es){offTop=!es[0].isIntersecting&&es[0].boundingClientRect.top<0;upd()}).observe(top);
new IntersectionObserver(function(es){atEnd=es[0].isIntersecting;upd()}).observe(fin)}
})();
</script>

