<script>
(function(){
  var v=document.getElementById('aih-vid');if(!v)return;
  var src=(window.innerWidth<=900?v.dataset.srcSm:v.dataset.srcLg)||v.dataset.srcLg;
  v.muted=true;v.defaultMuted=true;v.playsInline=true;v.setAttribute('muted','');
  v.src=src;
  var tried=false;
  function go(){var p=v.play();if(p&&p.catch)p.catch(function(){if(!tried){tried=true;['touchstart','pointerdown','scroll','keydown'].forEach(function(e){window.addEventListener(e,once,{passive:true,once:true})})}})}
  function once(){v.muted=true;var p=v.play();if(p&&p.catch)p.catch(function(){})}
  v.addEventListener('canplay',go,{once:true});
  v.addEventListener('ended',function(){v.classList.add('done')});
  v.load();go();
  document.addEventListener('visibilitychange',function(){if(!document.hidden&&v.paused&&!v.ended)go()});
})();
</script>

<script>
(function(){
  var root=document.getElementById('aih-demo');if(!root)return;
  var ws=root.querySelector('.ws'),typ=root.querySelector('.ws-type'),st=root.querySelector('.ws-st'),steps=root.querySelector('.ws-steps'),out=root.querySelector('.ws-out'),bar=root.querySelector('.ws-prog i'),tabs=root.querySelectorAll('.ws-tabs button');
  var reduce=window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches;
  var T=[
   {p:"Aim: margin by product, Aug to Oct.\nReality: Nada Roastery sales export, 1,206 rows, messy dates and duplicates.\nRequest: clean it, compute margin with code, flag anything odd.\nStandard: show every number's formula.",
    s:["Removed duplicate orders","Standardized mixed date formats","Joined product costs, computed margin in code"],
    o:function(){return "<p class='o o-title'>Margin by product, Aug to Oct</p><div class='o o-chart'>"+[['Huila',92],['Yirga',74],['Kenya',66],['House',51],['Decaf',38],['Cold',24]].map(function(b){return "<div><b data-h='"+b[1]+"'></b><span>"+b[0]+"</span></div>"}).join('')+"</div><p class='o o-row'><em>FIND</em><span>Huila leads on margin, not on volume.</span></p><p class='o o-row'><em>FLAG</em><span>Cold brew margin fell after the October cost change.</span></p><p class='o o-badge'>Every figure computed by code</p>"}},
   {p:"Aim: should we launch an office coffee subscription in Amman?\nRequest: research demand, competitors, and pricing.\nWalls: cite every claim, prefer primary sources.\nOutput: one-page brief with a recommendation.",
    s:["Compared sources, kept the primary ones","Matched every claim to a source","Re-checked key citations against the originals"],
    o:function(){return "<p class='o o-title'>Office subscription: market brief</p><p class='o o-row'><em>1</em><span>Likely first buyers: co-working spaces and tech offices.<span class='o-src'>[1]</span><span class='o-src'>[4]</span></span></p><p class='o o-row'><em>2</em><span>Competitor office plans compared on price and contract length.<span class='o-src'>[2]</span></span></p><p class='o o-row'><em>3</em><span>Recommendation: pilot with 5 offices before setting a price.<span class='o-src'>[6]</span></span></p><p class='o o-badge'>Every key claim linked to a source</p>"}},
   {p:"Every Friday at 3 pm:\nRead this week's wholesale orders.\nSummarize totals, late payers, and stock below 10 days.\nSend me a one-page report. Never send anything to customers.",
    s:["Connected the orders sheet","Saved the brief as a reusable skill","Scheduled weekly, with a test run"],
    o:function(){return "<p class='o o-title'>Weekly wholesale summary</p><div class='o o-card'><div class='o-sched'><div>Runs every Friday, 3:00 pm<small>Next run in 2 days</small></div><span class='tog'></span></div><div class='o-line'><span>Fri 15:00</span><span>Orders read, totals computed</span><i>Done</i></div><div class='o-line'><span>Fri 15:01</span><span>Late payers flagged</span><i>Done</i></div><div class='o-line'><span>Fri 15:02</span><span>Report sent to you only</span><i>Done</i></div></div><p class='o o-badge'>Test run passed</p>"}}
  ];
  var cur=0,timer=[],running=false,userPick=false;
  function later(f,ms){timer.push(setTimeout(f,ms))}
  function clear(){timer.forEach(clearTimeout);timer=[]}
  function hl(t){return t.replace(/^(Aim|Reality|Request|Walls|Output|Standard):/gm,"<span class='k'>$1:</span>")}
  function play(i){
    clear();cur=i;tabs.forEach(function(b,k){b.classList.toggle('on',k===i);b.setAttribute('aria-selected',k===i)});
    var t=T[i];ws.classList.remove('thinking','done');out.innerHTML='';steps.innerHTML='';st.textContent='Writing the brief';bar.style.transition='none';bar.style.width='0';
    if(reduce){typ.innerHTML=hl(t.p);finish(t,true);return}
    var n=0;typ.innerHTML='';
    (function type(){n+=2;typ.innerHTML=hl(t.p.slice(0,n));if(n<t.p.length)later(type,22);else later(function(){think(t)},350)})();
  }
  function think(t){
    ws.classList.add('thinking');st.textContent='Working on it';
    t.s.forEach(function(x,k){later(function(){var d=document.createElement('div');d.textContent=x;steps.appendChild(d);requestAnimationFrame(function(){d.classList.add('in')})},500+k*650)});
    later(function(){finish(t,false)},500+t.s.length*650+300);
  }
  function finish(t,instant){
    ws.classList.remove('thinking');ws.classList.add('done');st.textContent='Done. Checked before delivery';
    if(instant){steps.innerHTML=t.s.map(function(x){return '<div class="in">'+x+'</div>'}).join('')}
    out.innerHTML=t.o();
    var items=out.querySelectorAll('.o');
    items.forEach(function(el,k){later(function(){el.classList.add('in');el.querySelectorAll('b[data-h]').forEach(function(b,j){setTimeout(function(){b.style.height=b.dataset.h+'%'},120+j*90)});var tg=el.querySelector('.tog');if(tg)setTimeout(function(){tg.classList.add('on')},500)},instant?0:k*260)});
    if(!instant){requestAnimationFrame(function(){bar.style.transition='width 6.5s linear';bar.style.width='100%'});later(function(){if(!userPick)play((cur+1)%T.length)},6800)}
  }
  tabs.forEach(function(b,k){b.addEventListener('click',function(){userPick=true;play(k)})});
  if('IntersectionObserver' in window){var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting&&!running){running=true;play(0)}})},{threshold:.35});io.observe(ws)}else play(0);
})();
</script>

