 var L=[['R','Reality','الخلفية والسياق','من أنت؟ ولمن يُكتب هذا؟ ماذا حدث، وماذا يعرف القارئ مسبقًا؟'],['A','Aim','الهدف','ما النتيجة الواقعية التي تريدها بعد استخدام المخرجات؟'],['R','Request','المهمة المطلوبة','ما الذي يُطلب من Claude بالضبط، وبأيّ مدخلات؟'],['O','Output','مواصفات المخرجات','اللغة، والطول، والبنية، والقالب.'],['W','Walls','القيود والحدود','ما يجب تجنّبه، وما لا يجوز افتراضه، وأيّ النبرات مقبول.'],['S','Standard','معيار قبول النتيجة','متى تصبح المخرجات جاهزة؟ حدّد شرطًا يمكنك التحقق منه.']];
 var lw=root.querySelector('.letters'),def=root.querySelector('.def'),lines=root.querySelectorAll('#dbody .ln'),step=-1,timer=null;
 [1,0,2,3,4,5].forEach(function(i){var l=L[i];var b=document.createElement('button');b.dataset.i=i;b.type='button';b.innerHTML='<b>'+l[0]+'</b><span>'+l[2]+'</span>';b.setAttribute('aria-label',l[1]+': '+l[2]);b.addEventListener('click',function(){stop();focusL(i,true)});lw.appendChild(b)});
 function focusL(i,showAll){[].forEach.call(lw.children,function(b){b.classList.toggle('on',+b.dataset.i===i)});
  def.innerHTML='<b><span class="en">'+L[i][1]+'</span> · '+L[i][2]+'</b><br>'+esc(L[i][3]);
  lines.forEach(function(ln){var k=+ln.dataset.k;if(showAll)ln.classList.add('on');ln.classList.toggle('hi',k===i)})}
 function build(){stop();lines.forEach(function(l){l.classList.remove('on','hi')});step=-1;
  var order=[0,1,2,3,4,5];var n=0;
  (function next(){if(n>=order.length){timer=null;return}var i=order[n++];focusL(i,false);lines.forEach(function(ln){if(+ln.dataset.k===i)ln.classList.add('on')});timer=setTimeout(next,RM?0:1300)})()}
 function stop(){if(timer){clearTimeout(timer);timer=null}}
 function resetD(){stop();lines.forEach(function(l){l.classList.remove('on','hi')});[].forEach.call(lw.children,function(b){b.classList.remove('on')});def.innerHTML='<b>ستة عناصر للبرومبت القوي.</b><br>اضغط «ابنِ البرومبت» لترى كيف يتحوّل السطر الواحد إلى مواصفات واضحة، أو اختر حرفًا.'}
 root.querySelector('#dplay').addEventListener('click',build); root.querySelector('#dreset').addEventListener('click',resetD); resetD();
 if(!RM&&'IntersectionObserver' in window){var io2=new IntersectionObserver(function(es){if(es[0].isIntersecting){io2.disconnect();setTimeout(build,500)}},{threshold:.45});io2.observe(root.querySelector('#dbody'))}else lines.forEach(function(l){l.classList.add('on')});

 /* page rail (3D coverflow of real pages) */
 var PG=[['cover','الغلاف','طبعة أكتوبر 2026'],['paths','كيف تقرأ هذا الكتاب','ثلاثة مسارات للقراءة'],['arrows','الفصل 5 · إطار ARROWS','ستة عناصر للبرومبت القوي'],['work','الفصل 11','البريد والتقارير والاجتماعات والخطط'],['excel','الفصل 16','ملفات Excel وCSV'],['biz','الفصل 21','أربع حالات من الأعمال'],['code','الفصل 25','Claude Code: من التثبيت إلى أول مشروع'],['capstone','الفصل 31','خمسة مشاريع ختامية'],['pcats','مكتبة 120 برومبت','ثماني فئات']];
 var rail=root.querySelector('#rail'),cap=root.querySelector('#rcap'),ci=2,lb=root.querySelector('#lb');
 PG.forEach(function(p,i){var b=document.createElement('button');b.type='button';b.className='pgx';b.setAttribute('aria-label',p[1]+' · '+p[2]);b.innerHTML='<img src="'+IMG[p[0]]+'" alt="" loading="lazy" width="900" height="1273">';b.addEventListener('click',function(){if(i===ci)zoom();else{ci=i;lay()}});rail.appendChild(b)});
 var cards=rail.querySelectorAll('.pgx');
 function lay(){var sp=MOB?120:190;cards.forEach(function(c,i){var d=i-ci,a=Math.abs(d);c.style.transform='translate3d('+(-d*sp)+'px,'+(a?16:0)+'px,'+(-a*120)+'px) rotateY('+(d*-22)+'deg)';c.style.zIndex=20-a;c.style.opacity=a>3?0:1;c.style.filter=a?'brightness(.72)':'none';c.tabIndex=a>3?-1:0});
  cap.innerHTML=esc(PG[ci][1])+'<small>'+esc(PG[ci][2])+' · '+(ci+1)+' / '+PG.length+'</small>'}
 function zoom(){lb.querySelector('img').src=IMG[PG[ci][0]];lb.querySelector('img').alt=PG[ci][1];lb.classList.add('on');lb.querySelector('button').focus()}
 lb.addEventListener('click',function(e){if(e.target!==lb.querySelector('img'))lb.classList.remove('on')});
 document.addEventListener('keydown',function(e){if(e.key==='Escape')lb.classList.remove('on')});
 root.querySelector('#rnext').addEventListener('click',function(){ci=Math.min(PG.length-1,ci+1);lay()});
 root.querySelector('#rprev').addEventListener('click',function(){ci=Math.max(0,ci-1);lay()});
 root.querySelector('#rzoom').addEventListener('click',zoom);
 var sx=null;rail.addEventListener('touchstart',function(e){sx=e.touches[0].clientX},{passive:true});rail.addEventListener('touchend',function(e){if(sx===null)return;var dx=e.changedTouches[0].clientX-sx;if(Math.abs(dx)>40){ci=dx>0?Math.min(PG.length-1,ci+1):Math.max(0,ci-1);lay()}sx=null});
 lay();

 /* sticky bar */
 var sb=root.querySelector('.sbar'),off=root.querySelector('#offer');
 function st(){var o=off.getBoundingClientRect();sb.classList.toggle('on',scrollY>650&&!(o.top<innerHeight&&o.bottom>0))}
 addEventListener('scroll',st,{passive:true});st();

 /* live prices from the store (stay correct through price changes); bundle = Claude + ChatGPT − automatic discount */
 var S=window.Shopify||{},R=(S.routes&&S.routes.root)||'/',cur=(S.currency&&S.currency.active)||'USD',rate=parseFloat(S.currency&&S.currency.rate)||1;
 if(!D.handleC) return;
 function get(h){return fetch(R+'products/'+encodeURIComponent(h)+'.js',{credentials:'same-origin'}).then(function(r){if(!r.ok)throw 0;return r.json()})}
 var nf;try{nf=new Intl.NumberFormat('en-US',{style:'currency',currency:cur,minimumFractionDigits:0,maximumFractionDigits:2})}catch(e){nf={format:function(x){return '$'+x}}}
 Promise.all([get(D.handleC),get(D.handleG)]).then(function(a){var c=a[0].variants[0],g=a[1].variants[0];var cp=c.price/100,gp=g.price/100,dd=Math.round(D.disc*rate*100)/100,sum=cp+gp,b=Math.max(sum-dd,0);
  function set(cls,v){root.querySelectorAll(cls).forEach(function(e){e.textContent=v})}
  set('.js-pc',nf.format(cp));set('.js-pb',nf.format(b));set('.js-ps',nf.format(sum));set('.js-pd',nf.format(b-cp));
  root.querySelectorAll('.js-buy-c').forEach(function(x){x.href=R+'cart/'+c.id+':1'});root.querySelectorAll('.js-buy-b').forEach(function(x){x.href=R+'cart/'+g.id+':1,'+c.id+':1'});
 }).catch(function(){});
});
