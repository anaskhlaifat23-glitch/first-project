/* ===== DESIGN SYSTEM (taken from the book itself) =====
 paper #F4EFE7 (cover cream) · paper-2 #EBE4D8 · ink #17181C · ink-2 #4A4B52 · mute #77736B · rule #DDD4C6
 terracotta #C2583A (cover orb / actions) · terracotta-soft #E7B9A2 · navy #1C2A44 (book's dark callouts) · sage #DCE9E3 (book's "you will be able to" boxes)
 type: IBM Plex Sans Arabic (the book's typeface) 400/600/700 · Cormorant Garamond 600 for Latin "Claude" & numerals (as on the cover) · Plex Mono for prompt codes
 motion: reveal 700ms ease-out; demo builds; page-turn; everything off under prefers-reduced-motion */
.C4{--paper:#F4EFE7;--paper2:#EBE4D8;--ink:#17181C;--ink2:#4A4B52;--mute:#77736B;--rule:#DDD4C6;--tc:#C2583A;--tc2:#A9482D;--tcs:#F3DED2;--navy:#1C2A44;--sage:#E2EEE8;
 --side:clamp(20px,4.4vw,64px);--wrap:1280px;--ease:cubic-bezier(.2,.7,.2,1);
 direction:rtl;background:var(--paper);color:var(--ink);font-family:"C4",system-ui,sans-serif;font-size:18px;line-height:1.9;-webkit-font-smoothing:antialiased;overflow-x:clip}
.C4 *{box-sizing:border-box}
.C4 img,.C4 video{display:block;max-width:100%;height:auto}
.C4 a{color:inherit}
.C4 p{margin:0 0 14px}
.C4 h1,.C4 h2,.C4 h3,.C4 h4{margin:0;font-weight:700;letter-spacing:0;color:var(--ink)}
.C4 .en{direction:ltr;unicode-bidi:isolate}
.C4 .js-pc,.C4 .js-pb,.C4 .js-ps,.C4 .js-pd{direction:ltr;unicode-bidi:isolate;display:inline-block}
.C4 .mono{font-family:"C4M",ui-monospace,monospace;direction:ltr;unicode-bidi:isolate}
.C4 .serif{font-family:"C4S",Georgia,serif;font-weight:600;direction:ltr;unicode-bidi:isolate}
.C4 .wrap{max-width:var(--wrap);margin:0 auto;padding:0 var(--side)}
.C4 .kick{display:inline-flex;align-items:center;gap:10px;font-size:14px;font-weight:600;color:var(--tc2);margin-bottom:18px}
.C4 .kick:before{content:"";width:9px;height:9px;border-radius:50%;background:var(--tc)}
.C4 .h2{font-size:clamp(30px,3.5vw,50px);line-height:1.3}
.C4 .lead{font-size:clamp(17px,1.35vw,20px);color:var(--ink2);max-width:640px;margin-top:18px}
.C4 .btn{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:58px;padding:0 30px;border-radius:999px;background:var(--tc);color:#fff;text-decoration:none;font:700 17.5px/1 "C4",sans-serif;border:0;cursor:pointer;box-shadow:0 14px 30px -14px rgba(162,70,40,.75);transition:transform .25s var(--ease),background .25s}
.C4 .btn:hover{background:var(--tc2);transform:translateY(-2px)}
.C4 .btn.dark{background:var(--ink);box-shadow:none}
.C4 .btn.line{background:transparent;color:var(--ink);box-shadow:inset 0 0 0 1.5px var(--ink)}
.C4 .btn .ar{transition:transform .25s var(--ease)}.C4 .btn:hover .ar{transform:translateX(-4px)}
.C4 :focus-visible{outline:2.5px solid var(--tc);outline-offset:3px}
.C4 .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.C4 [data-rv]{opacity:0;transform:translateY(18px);transition:opacity .8s var(--ease),transform .8s var(--ease)}
.C4 [data-rv].in{opacity:1;transform:none}

/* ===== masthead ===== */
.C4 .mast{position:absolute;inset:0 0 auto 0;z-index:20}
.C4 .mast .wrap{height:74px;display:flex;align-items:center;justify-content:space-between}
.C4 .brand{display:flex;align-items:center;gap:8px;font-weight:700;font-size:16px}
.C4 .brand svg{width:18px;height:18px}
.C4 .mast nav{display:flex;gap:26px;font-size:15px}
.C4 .mast nav a{text-decoration:none;color:var(--ink2)}.C4 .mast nav a:hover{color:var(--ink)}
.C4 .mast .pill{text-decoration:none;font-weight:700;font-size:14.5px;background:var(--ink);color:#fff;padding:10px 18px;border-radius:999px}

/* ===== hero ===== */
.C4 .hero{position:relative;height:min(100vh,56.25vw);min-height:660px;max-height:980px;overflow:hidden;background:var(--paper)}
.C4 .hero .media{position:absolute;inset:74px 0 0 0}
.C4 .hero .media img,.C4 .hero .media video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:0 0}
.C4 .hero .media video{opacity:0;transition:opacity .9s var(--ease)}.C4 .hero .media video.on{opacity:1}
.C4 .hero .veil{position:absolute;inset:0;z-index:1;background:linear-gradient(270deg,rgba(244,239,231,.86) 0%,rgba(244,239,231,.62) 30%,rgba(244,239,231,0) 50%)}
.C4 .hero .copy{position:absolute;z-index:3;top:0;bottom:0;right:max(var(--side),calc((100vw - var(--wrap))/2 + var(--side)));width:min(540px,40vw);display:flex;flex-direction:column;justify-content:center;padding-top:50px}
.C4 .lock{display:flex;align-items:baseline;gap:16px;flex-wrap:wrap;line-height:1}
.C4 .lock .serif{font-size:clamp(66px,6.4vw,104px);letter-spacing:-.01em;color:var(--ink)}
.C4 .lock .ar{font-size:clamp(46px,4.4vw,72px);font-weight:700;color:var(--tc)}
.C4 .hero h1{font-size:clamp(20px,1.75vw,27px);line-height:1.6;font-weight:600;color:var(--ink);margin-top:22px}
.C4 .hero .sub{font-size:clamp(16px,1.2vw,18px);color:var(--ink2);margin:14px 0 26px}
.C4 .hero .row{display:flex;flex-wrap:wrap;align-items:center;gap:12px 22px}
.C4 .hero .alt{font-size:15.5px;color:var(--ink2);text-decoration:none;border-bottom:1px solid currentColor;padding-bottom:1px}
.C4 .hero .alt b{color:var(--ink)}
.C4 .hero .areas{list-style:none;margin:0 0 12px;padding:0;display:flex;flex-wrap:wrap;gap:7px}
.C4 .hero .areas li{font-size:15px;font-weight:600;color:var(--ink);background:rgba(255,255,255,.72);border:1px solid rgba(23,24,28,.14);border-radius:999px;padding:4px 13px;line-height:1.6}
.C4 .hero .plus{font-size:15.5px;color:var(--ink2);margin:0 0 22px}.C4 .hero .plus b{color:var(--tc);font-weight:700}
.C4 .hero .sub{margin-bottom:10px!important}
.C4 .btn2{display:inline-flex;flex-direction:column;align-items:center;justify-content:center;gap:0;text-decoration:none;color:var(--ink);border:1.5px solid var(--ink);border-radius:12px;padding:9px 18px;background:rgba(255,255,255,.55);line-height:1.5;transition:background .2s}
.C4 .btn2:hover{background:#fff}.C4 .btn2>span{font-size:15.5px;font-weight:600}.C4 .btn2 b{font-weight:700}
.C4 .btn2 small{font-size:12.5px;color:var(--ink2)}
.C4 .get{margin-top:24px;display:flex;flex-wrap:wrap;gap:8px}
.C4 .get span{font-size:13.5px;background:rgba(255,255,255,.62);border:1px solid rgba(23,24,28,.12);border-radius:999px;padding:5px 13px;color:var(--ink2);backdrop-filter:blur(4px)}
.C4 .get b{color:var(--ink);font-weight:600}
.C4 .hero .ctl{position:absolute;left:var(--side);bottom:22px;z-index:3;font:500 12.5px "C4";color:var(--ink2);background:rgba(244,239,231,.82);border:0;border-radius:999px;padding:7px 13px;cursor:pointer}

/* ===== areas ribbon ===== */
.C4 .ribbon{background:var(--ink);color:#EDE6DA}
.C4 .ribbon .wrap{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));}
.C4 .ribbon a{display:block;text-decoration:none;padding:22px 16px;border-inline-start:1px solid rgba(255,255,255,.1);font-size:15.5px;font-weight:600;line-height:1.5}
.C4 .ribbon a:first-child{border-inline-start:0}
.C4 .ribbon a small{display:block;font-weight:400;color:#A9A398;font-size:13px}
.C4 .ribbon a:hover{background:rgba(255,255,255,.04)}

/* ===== levels ===== */
.C4 .levels{padding:120px 0 100px}
.C4 .lv{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px;margin-top:52px}
.C4 .lv article{background:#FBF8F3;border:1px solid var(--rule);border-radius:22px;padding:30px 28px;position:relative;overflow:hidden}
.C4 .lv article:before{content:"";position:absolute;inset:0 0 auto 0;height:4px;background:var(--c)}
.C4 .lv h3{font-size:24px;margin-bottom:6px}
.C4 .lv .who{color:var(--mute);font-size:15px}
.C4 .lv p{font-size:16px;color:var(--ink2);margin:16px 0 18px}
.C4 .lv .ch{font-size:13.5px;color:var(--ink2);border-top:1px dashed var(--rule);padding-top:12px}
.C4 .lv .ch b{font-weight:600;color:var(--ink)}
.C4 .src{font-size:13px;color:var(--mute);margin-top:18px}

/* ===== applications (signature) ===== */
.C4 .apps{background:var(--paper2);padding:120px 0}
.C4 .tabs{display:flex;flex-wrap:wrap;gap:10px;margin-top:40px}
.C4 .tabs button{font:600 15.5px "C4";border:1px solid var(--rule);background:#FBF8F3;color:var(--ink2);border-radius:999px;padding:11px 20px;cursor:pointer;transition:all .25s}
.C4 .tabs button[aria-selected=true]{background:var(--ink);color:#fff;border-color:var(--ink)}
.C4 .tabs button:hover{border-color:var(--ink)}
.C4 .panel{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:56px;margin-top:40px;align-items:center;min-height:620px}
.C4 .panel .txt h3{font-size:clamp(26px,2.5vw,36px);line-height:1.35}
.C4 .panel .txt .intro{color:var(--ink2);margin:14px 0 22px}
.C4 .panel ul.do{list-style:none;margin:0;padding:0;border-top:1px solid var(--rule)}
.C4 .panel ul.do li{padding:13px 30px 13px 0;border-bottom:1px solid var(--rule);font-size:16.5px;position:relative;line-height:1.7}
.C4 .panel ul.do li:before{content:"";position:absolute;right:4px;top:22px;width:10px;height:10px;border-radius:50%;border:2px solid var(--tc)}
.C4 .panel .chs{font-size:14px;color:var(--mute);margin-top:16px}
.C4 .panel .pr{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}
.C4 .panel .pr span{font-size:14px;background:#FBF8F3;border:1px solid var(--rule);border-radius:10px;padding:6px 12px}
.C4 .panel .pr .mono{color:var(--tc2);font-size:12.5px;margin-left:6px}
.C4 .panel .vis{position:relative;perspective:1600px}
.C4 .panel .sheet{position:relative;border-radius:6px;overflow:hidden;box-shadow:0 50px 70px -40px rgba(60,40,20,.55),0 2px 8px rgba(60,40,20,.15);transform:rotate(-2.2deg);background:#fff;transition:transform .8s var(--ease)}
.C4 .panel .sheet img{width:100%}
.C4 .panel .vis .tag{position:absolute;top:-16px;left:-10px;background:var(--tc);color:#fff;font-weight:700;font-size:14px;border-radius:999px;padding:7px 15px;z-index:2;box-shadow:0 10px 20px -10px rgba(162,70,40,.7)}
.C4 .panel.swap .sheet{animation:c4turn .7s var(--ease)}
.C4 .panel.swap .txt{animation:c4in .6s var(--ease)}
@keyframes c4turn{from{transform:rotate(-2.2deg) rotateY(-70deg);transform-origin:100% 50%;opacity:.2}to{transform:rotate(-2.2deg) rotateY(0);opacity:1}}
@keyframes c4in{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.C4 .apps .note{font-size:13.5px;color:var(--mute);margin-top:26px}

/* ===== ARROWS demo ===== */
.C4 .demo{padding:120px 0;background:var(--paper)}
.C4 .dg{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:56px;margin-top:48px;align-items:start}
.C4 .letters{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:8px;margin-top:28px;direction:ltr}
.C4 .letters button{all:unset;cursor:pointer;text-align:center;border-radius:14px;padding:12px 4px 10px;background:#FBF8F3;border:1px solid var(--rule);transition:all .3s}
.C4 .letters button b{display:block;font-family:"C4S",serif;font-size:34px;line-height:1;color:var(--ink)}
.C4 .letters button span{display:block;font-size:12px;color:var(--mute);margin-top:6px;line-height:1.3}
.C4 .letters button.on{background:var(--ink);border-color:var(--ink)}.C4 .letters button.on b{color:#fff}.C4 .letters button.on span{color:#C9C2B6}
.C4 .letters button:focus-visible{outline:2.5px solid var(--tc)}
.C4 .def{margin-top:18px;min-height:96px;font-size:16px;color:var(--ink2);border-inline-start:3px solid var(--tc);padding-inline-start:16px}
.C4 .def b{color:var(--ink)}
.C4 .cmp{display:grid;gap:16px}
.C4 .card{background:#fff;border:1px solid var(--rule);border-radius:18px;overflow:hidden}
.C4 .card .hd{display:flex;justify-content:space-between;align-items:center;padding:12px 20px;border-bottom:1px solid var(--rule);font-size:13.5px;color:var(--mute)}
.C4 .card .hd b{font-size:14.5px;color:var(--ink)}
.C4 .card.weak .hd b{color:#A33A2A}
.C4 .card.strong .hd b{color:#1F5E46}
.C4 .card .bd{padding:18px 22px;font-size:16px;line-height:2}
.C4 .card.weak .bd{color:var(--ink2);background:#FBF3F1}
.C4 .card.strong .bd{background:#F3F8F5;min-height:360px}
.C4 .ln{display:block;opacity:.18;transition:opacity .5s,background .5s;border-radius:6px;padding:0 6px;margin:0 -6px}
.C4 .ln .k{font-family:"C4S",serif;font-weight:600;font-size:18px;color:#1F5E46;margin-inline-end:8px;display:inline-block;min-width:16px}
.C4 .ln.on{opacity:1}
.C4 .ln.hi{background:rgba(31,94,70,.10)}
.C4 .demo .ctrl{display:flex;gap:10px;margin-top:18px;flex-wrap:wrap}
.C4 .demo .ctrl .btn{min-height:46px;padding:0 20px;font-size:15px}
.C4 .demo .why{font-size:13.5px;color:var(--mute);margin-top:14px}

/* ===== page explorer ===== */
.C4 .flip{background:var(--navy);color:#E9E3D8;padding:120px 0 110px;overflow:hidden}
.C4 .flip .h2{color:#fff}.C4 .flip .lead{color:#B9BFCB}.C4 .flip .kick{color:#E7B9A2}
.C4 .rail{position:relative;margin-top:50px;height:520px;perspective:1700px}
.C4 .rail .pgx{position:absolute;top:10px;left:50%;width:300px;margin-left:-150px;aspect-ratio:1/1.4142;border:0;padding:0;background:#fff;cursor:pointer;border-radius:3px;overflow:hidden;transition:transform .9s var(--ease),opacity .6s,filter .6s;box-shadow:0 40px 60px -30px rgba(0,0,0,.7)}
.C4 .rail .pgx img{width:100%;height:100%;object-fit:cover}
.C4 .rail .pgx:focus-visible{outline:3px solid #E7B9A2;outline-offset:4px}
.C4 .rail-cap{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-top:10px;flex-wrap:wrap}
.C4 .rail-cap .t{font-size:17px;font-weight:600;color:#fff}
.C4 .rail-cap .t small{display:block;font-weight:400;font-size:14px;color:#B9BFCB}
.C4 .rail-cap .nv{display:flex;gap:8px}
.C4 .rail-cap .nv button{width:46px;height:46px;border-radius:50%;border:1px solid rgba(255,255,255,.35);background:transparent;color:#fff;font-size:18px;cursor:pointer}
.C4 .rail-cap .nv button.z{width:auto;padding:0 18px;border-radius:999px;font:600 14px "C4"}
.C4 .lb{position:fixed;inset:0;z-index:100;background:rgba(14,18,28,.88);display:none;align-items:center;justify-content:center;padding:24px}
.C4 .lb.on{display:flex}
.C4 .lb img{max-height:92vh;width:auto;max-width:94vw;border-radius:3px;box-shadow:0 30px 60px rgba(0,0,0,.6)}
.C4 .lb button{position:absolute;top:18px;left:18px;width:46px;height:46px;border-radius:50%;border:0;background:#fff;font-size:20px;cursor:pointer}

/* ===== contents ===== */
.C4 .toc{padding:120px 0}
.C4 .parts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0 40px;margin-top:44px;border-top:1px solid var(--ink)}
.C4 .parts div{display:grid;grid-template-columns:44px 1fr;gap:10px;padding:16px 0;border-bottom:1px solid var(--rule)}
.C4 .parts .n{font-family:"C4S",serif;font-size:26px;line-height:1.1;color:var(--tc)}
.C4 .parts b{display:block;font-size:16.5px}
.C4 .parts span{font-size:14px;color:var(--mute);line-height:1.7}

/* ===== receive ===== */
.C4 .rec{background:var(--paper2);padding:120px 0}
.C4 .rg{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px;margin-top:48px}
.C4 .rg article{background:#FBF8F3;border-radius:22px;border:1px solid var(--rule);overflow:hidden;display:flex;flex-direction:column}
.C4 .rg .im{aspect-ratio:4/3;background:#E6DED1;display:flex;align-items:flex-end;justify-content:center;overflow:hidden;padding-top:26px}
.C4 .rg .im img{width:62%;box-shadow:0 30px 40px -24px rgba(60,40,20,.6);border-radius:3px 3px 0 0}
.C4 .rg .im.zip{align-items:center;padding:0}
.C4 .rg .bd{padding:24px 24px 26px}
.C4 .rg h3{font-size:21px}
.C4 .rg .spec{font-family:"C4M";direction:ltr;text-align:right;font-size:12.5px;color:var(--mute);margin:4px 0 12px}
.C4 .rg ul{margin:0;padding:0 18px 0 0;font-size:15.5px;color:var(--ink2)}
.C4 .rg li{margin-bottom:5px}
.C4 .verified{display:flex;gap:14px;align-items:flex-start;margin-top:26px;background:#FBF8F3;border:1px solid var(--rule);border-radius:16px;padding:18px 22px;font-size:15.5px;color:var(--ink2)}
.C4 .verified b{color:var(--ink)}

/* ===== offer ===== */
.C4 .coll{padding:110px 0 40px;background:#EFE8DC}
.C4 .trio{display:grid;grid-template-columns:1fr 1.12fr 1fr;gap:28px;align-items:end;margin-top:44px}
.C4 .trio figure{margin:0;text-align:center}
.C4 .trio img{width:100%;height:auto;border-radius:6px;box-shadow:0 30px 60px -28px rgba(23,24,28,.45),0 2px 6px rgba(23,24,28,.12)}
.C4 .trio .mid img{transform:translateY(-14px)}
.C4 .trio figcaption{margin-top:18px}.C4 .trio figcaption b{display:block;font-size:17px}.C4 .trio figcaption span{display:block;font-size:14px;color:var(--mute);margin-top:4px}
.C4 .trio em{font-style:normal;font-size:12px;font-weight:700;background:var(--tc);color:#fff;border-radius:99px;padding:2px 9px;margin-right:6px;vertical-align:2px}
.C4 .week{display:grid;grid-template-columns:260px 1fr;gap:44px;align-items:center;margin-top:64px;background:#FBF8F3;border:1px solid var(--rule);border-radius:26px;padding:34px}
.C4 .week img{width:100%;height:auto;border-radius:6px;box-shadow:0 18px 40px -20px rgba(23,24,28,.4)}
.C4 .week h3{font-size:22px;margin-bottom:12px}
.C4 .week ol{margin:0;padding-right:22px}.C4 .week li{font-size:16px;line-height:1.9}
.C4 .week li::marker{color:var(--tc);font-weight:700}
.C4 .offer{padding:120px 0;background:var(--paper)}
.C4 .og{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.12fr);gap:22px;margin-top:48px;align-items:stretch}
