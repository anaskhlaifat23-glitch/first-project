{%- capture aisa_bd -%}{%- render 'aisa-bundle-discount' -%}{%- endcapture -%}
{%- liquid
 assign bundle_disc = aisa_bd | strip | plus: 0
 assign cl = all_products['claude-بلا-تخمين-الدليل-العربي-العملي']
 assign gp = all_products['chatgpt-arabic']
 assign c_p = cl.price | default: 1900
 assign g_p = gp.price | default: 900
 assign s_p = c_p | plus: g_p
 assign b_p = s_p | minus: bundle_disc
 assign d_p = b_p | minus: c_p
-%}
