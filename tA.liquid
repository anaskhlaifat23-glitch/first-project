{% comment %}
  AI Step Ahead hub (Night Majlis). Arabic RTL home: video hero, animated arabesque, tracks (live + coming soon w/ waitlist), library, method, film band, principles, FAQ.
{% endcomment %}
{%- liquid
  assign gpt = all_products['chatgpt-arabic']
  assign cld = all_products[section.settings.claude_handle]
  assign gpt_price = gpt.price | default: 900
  assign cld_price = cld.price | default: 900
  assign bundle_disc = 400
  assign bundle_total = gpt_price | plus: cld_price | minus: bundle_disc
  assign bundle_full = gpt_price | plus: cld_price
  assign gpt_var = gpt.selected_or_first_available_variant.id | default: 55563696013649
  assign cld_var = cld.selected_or_first_available_variant.id | default: 55538560631121
-%}
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Kufi+Arabic:wght@500;700;800&display=swap" rel="stylesheet">
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <pattern id="nm-star" width="120" height="120" patternUnits="userSpaceOnUse">
      <g fill="none" stroke="currentColor" stroke-width="1">
        <path d="M60 8 L74 46 L112 60 L74 74 L60 112 L46 74 L8 60 L46 46 Z"/>
        <path d="M23 23 L60 38 L97 23 L82 60 L97 97 L60 82 L23 97 L38 60 Z"/>
        <circle cx="60" cy="60" r="14"/>
        <path d="M0 0 L23 23 M120 0 L97 23 M0 120 L23 97 M120 120 L97 97"/>
      </g>
    </pattern>
  </defs>
</svg>
<div class="nm" dir="rtl" lang="ar">

  <section class="nm-hero">
    <video class="nm-hero__v nm-hero__v--d" autoplay muted loop playsinline preload="metadata" poster="{{ 'nm-work.jpg' | file_url }}&width=1600">
      <source src="{{ section.settings.hero_desktop }}" type="video/mp4">
    </video>
    <video class="nm-hero__v nm-hero__v--m" autoplay muted loop playsinline preload="metadata" poster="{{ 'nm-work.jpg' | file_url }}&width=900">
      <source src="{{ section.settings.hero_mobile }}" type="video/mp4">
    </video>
    <div class="nm-hero__shade"></div>
    <svg class="nm-hero__pat" aria-hidden="true"><rect width="100%" height="100%" fill="url(#nm-star)"/></svg>
    <div class="nm-w nm-hero__in">
      <span class="nm-eb nm-rv">AI Step Ahead · خطوة سبّاقة في الذكاء الاصطناعي</span>
      <h1 class="nm-rv">مرجعك العربي في<br><em>الذكاء الاصطناعي</em></h1>
      <p class="nm-sub nm-rv">أدلّة عملية بالعربية، تُكتب لتُطبَّق في عملك من اليوم الأول. كلّ طلب فيها مجرَّب، وكلّ معلومة متغيّرة مؤرَّخة ومنسوبة إلى مصدرها الرسمي.</p>
      <div class="nm-ctas nm-rv">
        <a class="nm-btn" href="#nm-tracks">اختر مسارك</a>
        <a class="nm-btn nm-btn--line" href="#nm-library">تصفّح المكتبة</a>
      </div>
      <ul class="nm-stats nm-rv">
        <li><b data-count="2">2</b><span>دليلان منشوران</span></li>
        <li><b data-count="600">600</b><span>صفحة عملية</span></li>
        <li><b data-count="240">240</b><span>طلبًا جاهزًا للنسخ</span></li>
        <li><b>100%</b><span>بالعربية أولًا</span></li>
      </ul>
    </div>
    <a class="nm-scroll" href="#nm-tracks" aria-label="انزل"><span></span></a>
  </section>

  <div class="nm-ticker" aria-hidden="true"><div class="nm-ticker__t">
    {%- for i in (1..2) -%}
      <span>ChatGPT</span><i>✦</i><span>Claude</span><i>✦</i><span>الذكاء الاصطناعي في العمل</span><i>✦</i><span>الإعلانات والتسويق</span><i>✦</i><span>الإدارة والقيادة</span><i>✦</i><span>روّاد الأعمال</span><i>✦</i><span>المحتوى والكتابة</span><i>✦</i><span>البيانات وExcel</span><i>✦</i><span>الأتمتة</span><i>✦</i>
    {%- endfor -%}
  </div></div>

  <section class="nm-sec" id="nm-tracks">
    <div class="nm-w">
      <div class="nm-head nm-rv">
        <span class="nm-kick">المسارات</span>
        <h2>طريقك إلى الذكاء الاصطناعي، حسب دورك</h2>
        <p>كلّ مسار مكتبة متكاملة من الأدلّة والقوالب. نبدأ بالأدوات، ثم نبني لكلّ دور مساره الخاص.</p>
      </div>
      <div class="nm-tracks">
        <a class="nm-track nm-track--live nm-rv" href="#nm-library">
          <img src="{{ 'nm-work.jpg' | file_url }}&width=900" alt="موظفة تعمل على حاسوبها ليلًا في مكتب حديث" loading="lazy" width="900" height="1200">
          <div class="nm-track__c">
            <span class="nm-badge nm-badge--live">متاح الآن · دليلان</span>
            <h3>الذكاء الاصطناعي في العمل</h3>
            <p>ChatGPT وClaude من أوّل محادثة إلى مشاريع كاملة: البريد، والتقارير، والعقود، والجداول.</p>
            <span class="nm-more">افتح المكتبة ←</span>
          </div>
        </a>
        {%- assign soon = 'ads|managers|founders' | split: '|' -%}
        {%- for s in soon -%}
          {%- case s -%}
            {%- when 'ads' -%}{%- assign img = 'nm-ads.jpg' -%}{%- assign t = 'الذكاء الاصطناعي للإعلانات' -%}{%- assign d = 'أفكار الإعلانات، والنصوص، والصور والفيديو، وتحليل النتائج، بطريقة تحمي ميزانيتك.' -%}{%- assign alt = 'مسوّق يراجع إعلان فيديو على جواله' -%}
            {%- when 'managers' -%}{%- assign img = 'nm-manager.jpg' -%}{%- assign t = 'الذكاء الاصطناعي للمديرين' -%}{%- assign d = 'قرارات أسرع، وتقارير أوضح، وفريق يعمل مع الذكاء الاصطناعي بسياسة آمنة.' -%}{%- assign alt = 'مدير يقدّم عرضًا لفريقه في قاعة اجتماعات' -%}
            {%- when 'founders' -%}{%- assign img = 'nm-entrepreneur.jpg' -%}{%- assign t = 'الذكاء الاصطناعي لروّاد الأعمال' -%}{%- assign d = 'متجرك، وعملاؤك، ومحتواك، وأرقامك: مساعد يعمل معك كأنه فريق كامل.' -%}{%- assign alt = 'صاحبة مشروع قهوة تعمل على حاسوبها في متجرها' -%}
          {%- endcase -%}
          {%- assign fid = 'nm-wait-' | append: s -%}
          <div class="nm-track nm-rv">
            <img src="{{ img | file_url }}&width=900" alt="{{ alt }}" loading="lazy" width="900" height="1200">
            <div class="nm-track__c">
              <span class="nm-badge">قريبًا</span>
              <h3>{{ t }}</h3>
              <p>{{ d }}</p>
              {%- form 'customer', class: 'nm-wait', id: fid -%}
                <input type="hidden" name="contact[tags]" value="waitlist,waitlist-{{ s }}">
                {%- if form.posted_successfully? -%}<span class="nm-ok">سجّلناك، وسنراسلك عند الإطلاق.</span>{%- else -%}
                <input type="email" name="contact[email]" required placeholder="بريدك للإشعار عند الإطلاق" aria-label="البريد الإلكتروني">
                <button type="submit">أبلغني</button>{%- endif -%}
              {%- endform -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>

  <section class="nm-sec nm-lib" id="nm-library">
    <svg class="nm-pat2" aria-hidden="true"><rect width="100%" height="100%" fill="url(#nm-star)"/></svg>
    <div class="nm-w">
      <div class="nm-head nm-rv">
        <span class="nm-kick">المكتبة</span>
        <h2>ابدأ بأداتك</h2>
        <p>دليلان مستقلّان، لكلّ أداة طريقتها وإعداداتها وأمثلتها. الطريقة نفسها في روحها: اطلب بوضوح، وتأكّد قبل أن تعتمد.</p>
      </div>
      <div class="nm-books">
        {%- for b in (1..2) -%}
          {%- if b == 1 -%}
            {%- assign url = '/pages/chatgpt-arabic' -%}{%- assign name = 'ChatGPT بلا تخمين' -%}{%- assign price = gpt_price -%}{%- assign var = gpt_var -%}{%- assign img = 'gpt-product-square.jpg' -%}{%- assign tag = 'جديد' -%}
          {%- else -%}
            {%- assign url = '/pages/claude-arabic' -%}{%- assign name = 'Claude بلا تخمين' -%}{%- assign price = cld_price -%}{%- assign var = cld_var -%}{%- assign img = 'product-square.jpg' -%}{%- assign tag = 'الأكثر مبيعًا' -%}
          {%- endif -%}
          <article class="nm-book nm-rv">
            <span class="nm-tag">{{ tag }}</span>
            <a href="{{ url }}" class="nm-book__img"><img src="{{ img | file_url }}&width=800" alt="{{ name }}" loading="lazy" width="800" height="800"></a>
            <div class="nm-book__b">
              <h3><span class="nm-en">{{ name | split: ' ' | first }}</span> بلا تخمين</h3>
              {%- if b == 1 -%}
                <ul><li>298 صفحة و32 فصلًا، ونسخة مصمَّمة للجوّال</li><li>طريقة «المِقاس» وبروتوكول «تأكَّد»</li><li>كلّ طلب في الكتاب مجرَّب على ChatGPT نفسه</li><li>هدية: 120 طلبًا جاهزًا وملفات تدريب</li></ul>
              {%- else -%}
                <ul><li>299 صفحة و33 فصلًا</li><li>إطار ARROWS وبروتوكول تحقّق</li><li>مشاريع وذاكرة وأتمتة وبرمجة للمبتدئين</li><li>هدية: 120 برومبت جاهزًا وملفات تدريب</li></ul>
              {%- endif -%}
              <div class="nm-price">{{ price | money_without_trailing_zeros }}</div>
              <div class="nm-book__ctas">
                <a class="nm-btn" href="/cart/{{ var }}:1">اشترِ الآن</a>
                <a class="nm-link" href="{{ url }}">تفاصيل الكتاب ←</a>
              </div>
            </div>
          </article>
        {%- endfor -%}
      </div>
      <div class="nm-bundle nm-rv">
        <img src="{{ 'nm-books.jpg' | file_url }}&width=700" alt="الكتابان على مكتب خشبي تحت ضوء مشربية" loading="lazy" width="700" height="933">
        <div class="nm-bundle__b">
          <span class="nm-kick">الأوفر</span>
          <h3>الكتابان معًا: <span class="nm-en">ChatGPT</span> + <span class="nm-en">Claude</span></h3>
          <p>تستخدم الأداتين؟ خذ الدليلين بهديّتيهما وملفات تدريبهما. الخصم يُطبَّق تلقائيًّا عند الدفع.</p>
          <div class="nm-price">{{ bundle_total | money_without_trailing_zeros }} <s>{{ bundle_full | money_without_trailing_zeros }}</s></div>
          <a class="nm-btn" href="/cart/{{ gpt_var }}:1,{{ cld_var }}:1">أريد الكتابين</a>
        </div>
      </div>
    </div>
  </section>

  <section class="nm-sec">
    <div class="nm-w">
      <div class="nm-head nm-rv">
        <span class="nm-kick">الطريقة</span>
        <h2>طريقة واحدة، في كلّ ما ننشر</h2>
      </div>
      <ol class="nm-steps">
        <li class="nm-rv"><span>١</span><h3>اطلب بوضوح</h3><p>الهدف، والسياق، والجمهور، والحدود، والشكل. فلا يبقى للأداة ما تخمّنه.</p></li>
        <li class="nm-rv"><span>٢</span><h3>تأكّد قبل أن تعتمد</h3><p>التاريخ، والأصل، والأرقام، والدليل. أربعة أسئلة قبل أن ترسل أيّ شيء.</p></li>
        <li class="nm-rv"><span>٣</span><h3>طبّق على عملك</h3><p>أمثلة من سوقنا وبلغتنا، وملفات تدريب تفتحها وتجرّب عليها بنفسك.</p></li>
      </ol>
    </div>
  </section>

  <section class="nm-film">
    <video autoplay muted loop playsinline preload="none" poster="{{ 'nm-manager.jpg' | file_url }}&width=1600"><source src="{{ section.settings.film }}" type="video/mp4"></video>
    <div class="nm-film__shade"></div>
    <blockquote class="nm-w nm-rv"><p>الأداة متاحة للجميع.<br><em>الطريقة هي الفرق.</em></p><cite>AI Step Ahead</cite></blockquote>
  </section>

  <section class="nm-sec">
    <div class="nm-w">
      <div class="nm-head nm-rv"><span class="nm-kick">مبادئنا</span><h2>لماذا تثق بما ننشر؟</h2></div>
      <div class="nm-pr">
        <div class="nm-rv"><i>✦</i><h3>مجرَّب قبل النشر</h3><p>نختبر الطلبات على الأدوات نفسها، ونكتب ما وجدناه فعلًا، لا ما نتوقّعه.</p></div>
        <div class="nm-rv"><i>✦</i><h3>مؤرَّخ ومنسوب</h3><p>كلّ معلومة قد تتغيّر نذكر تاريخ التحقّق منها ومصدرها الرسمي.</p></div>
        <div class="nm-rv"><i>✦</i><h3>عربي أولًا</h3><p>أمثلة من بيئة العمل العربية، ولغة واضحة، ومصطلحات مشروحة.</p></div>
        <div class="nm-rv"><i>✦</i><h3>ضمان 30 يومًا</h3><p>إن لم يناسبك الدليل، راسلنا خلال 30 يومًا ونعيد لك المبلغ كاملًا.</p></div>
      </div>
    </div>
  </section>

  <section class="nm-sec nm-faqs">
    <div class="nm-w nm-faq">
      <div class="nm-head nm-rv"><span class="nm-kick">أسئلة</span><h2>أسئلة شائعة</h2></div>
      <details class="nm-rv"><summary>أيّ الكتابين أختار؟</summary><p>اختر كتاب الأداة التي تستخدمها كلّ يوم. وإن كنت تستخدم الاثنين، فالباقة أوفر.</p></details>
      <details class="nm-rv"><summary>هل تناسب المبتدئين؟</summary><p>نعم. كلّ دليل يبدأ من أوّل محادثة، ثم يتدرّج حتى المشاريع الكاملة.</p></details>
      <details class="nm-rv"><summary>كيف أستلم الكتب؟</summary><p>روابط التنزيل تظهر فور الدفع في صفحة تأكيد الطلب، وتصلك على بريدك الإلكتروني.</p></details>
      <details class="nm-rv"><summary>متى تصدر المسارات الجديدة؟</summary><p>سجّل بريدك في المسار الذي يهمّك، وسنراسلك عند إطلاقه أوّلًا، مع سعر خاص للمسجّلين.</p></details>
      <details class="nm-rv"><summary>ماذا لو لم يعجبني؟</summary><p>راسلنا على support@aistepahead.com خلال 30 يومًا من الشراء، ونعيد لك المبلغ كاملًا. التفاصيل في <a href="/policies/refund-policy">سياسة الاسترداد</a>.</p></details>
      <p class="nm-fine">أدلّة تعليمية مستقلّة، غير تابعة لشركتَي OpenAI وAnthropic ولا معتمدة منهما. «ChatGPT» و«Claude» علامتان تجاريتان لمالكيهما.</p>
    </div>
  </section>
</div>
<script>
(function(){
  var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('is-in');io.unobserve(e.target)}})},{threshold:.15});
  document.querySelectorAll('.nm-rv').forEach(function(el,i){el.style.transitionDelay=(i%4)*90+'ms';io.observe(el)});
  var done=false,st=document.querySelector('.nm-stats');
  if(st){new IntersectionObserver(function(es,o){if(es[0].isIntersecting&&!done){done=true;o.disconnect();st.querySelectorAll('b[data-count]').forEach(function(b){var n=+b.dataset.count,t0=null;function f(t){t0=t0||t;var p=Math.min(1,(t-t0)/1400);b.textContent=Math.round(n*(1-Math.pow(1-p,3)))+(n>=100?'+':'');if(p<1)requestAnimationFrame(f)}requestAnimationFrame(f)})}},{threshold:.4}).observe(st)}
  var mq=window.matchMedia('(max-width:749px)');function pick(){document.querySelectorAll('.nm-hero__v').forEach(function(v){var m=v.classList.contains('nm-hero__v--m');var on=mq.matches?m:!m;if(on){v.play&&v.play().catch(function(){})}else{v.pause&&v.pause()}})}pick();mq.addEventListener&&mq.addEventListener('change',pick);
  if(window.matchMedia('(prefers-reduced-motion: reduce)').matches){document.querySelectorAll('.nm video').forEach(function(v){v.pause()})}
})();
</script>

{% schema %}
{
  "name": "AI Step Ahead hub (Night Majlis)",
  "settings": [
    { "type": "text", "id": "claude_handle", "label": "Claude book handle", "default": "claude-بلا-تخمين-الدليل-العربي-العملي" },
    { "type": "text", "id": "hero_desktop", "label": "Hero video URL (desktop mp4)" },
    { "type": "text", "id": "hero_mobile", "label": "Hero video URL (mobile mp4)" },
    { "type": "text", "id": "film", "label": "Film band video URL (mp4)" }
  ],
  "presets": [{ "name": "AI Step Ahead hub (Night Majlis)" }]
}
{% endschema %}
