{%- comment -%}
  AI Step Ahead · v21 "AI lab" look. Scoped to the two Arabic sales pages.
  Decorative only: no copy, links, prices, section order or tracking touched. Content is fully visible without JS.
{%- endcomment -%}
{%- if page.handle == 'claude-arabic' or page.handle == 'chatgpt-arabic' -%}
<style id="aisa-polish">
  @property --aisa-a{syntax:'<angle>';inherits:false;initial-value:0deg}

  /* ── 1 · HERO: AI-lab stage ───────────────────────────── */
  .cwar .hero{position:relative;isolation:isolate;overflow:hidden;background:#050B17 radial-gradient(120% 90% at 85% 0%,#14284D 0%,#081020 55%,#050B17 100%)}
  .cwar .hero>.w{position:static}
  .cwar .hero>.w::before{content:"";position:absolute;inset:-25% -15%;z-index:-1;pointer-events:none;will-change:transform;
    background:
      radial-gradient(34% 42% at 24% 52%,rgba(236,196,112,.32),rgba(236,196,112,0) 70%),
      radial-gradient(30% 38% at 74% 18%,rgba(72,124,255,.30),rgba(72,124,255,0) 70%),
      radial-gradient(26% 30% at 90% 88%,rgba(72,124,255,.16),rgba(72,124,255,0) 70%);
    animation:aisaAur 20s ease-in-out infinite alternate}
  .cwar .hero>.w::after{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;
    background-image:linear-gradient(rgba(233,210,155,.07) 1px,transparent 1px),linear-gradient(90deg,rgba(233,210,155,.07) 1px,transparent 1px);
    background-size:56px 56px;-webkit-mask-image:radial-gradient(75% 65% at 50% 45%,#000 0%,transparent 78%);mask-image:radial-gradient(75% 65% at 50% 45%,#000 0%,transparent 78%)}
  @keyframes aisaAur{0%{transform:translate3d(0,0,0) scale(1)}50%{transform:translate3d(3%,-3%,0) scale(1.07)}100%{transform:translate3d(-3%,2%,0) scale(1.03)}}

  /* live dot on the edition label */
  .cwar .hero .eb{position:relative;padding-inline-start:34px!important;border-color:rgba(233,210,155,.35)!important;background:rgba(233,210,155,.08)!important;backdrop-filter:blur(6px)}
  .cwar .hero .eb::before{content:"";position:absolute;inset-inline-start:14px;top:50%;width:8px;height:8px;margin-top:-4px;border-radius:50%;background:#3DDC97;box-shadow:0 0 0 0 rgba(61,220,151,.6);animation:aisaLive 2.2s ease-out infinite}
  @keyframes aisaLive{0%{box-shadow:0 0 0 0 rgba(61,220,151,.55)}80%,100%{box-shadow:0 0 0 10px rgba(61,220,151,0)}}

  /* gold headline words: one sweep of light on load */
  .cwar .hero h1 em{background-image:linear-gradient(100deg,#E9D29B 0%,#C9A45C 30%,#FFF1C9 45%,#C9A45C 60%,#E9D29B 100%)!important;background-size:250% 100%!important;background-position:100% 0;-webkit-background-clip:text;background-clip:text;animation:aisaGold 2.6s .6s cubic-bezier(.5,0,.3,1) 1 both}
  @keyframes aisaGold{from{background-position:100% 0}to{background-position:0 0}}
  .cwar h1,.cwar h2{text-wrap:balance}

  /* the book: floating 3D product shot with orbit ring + rim light */
  .cwar .hero .g>div:last-child{position:relative;isolation:isolate;perspective:1400px;--aisa-glow:1}
  .cwar .hero .g>div:last-child::before{content:"";position:absolute;inset:-4% -4% -8%;z-index:-2;border-radius:50%;pointer-events:none;opacity:var(--aisa-glow);
    background:radial-gradient(closest-side,rgba(240,200,118,.45),rgba(201,164,92,.16) 55%,rgba(201,164,92,0) 100%);filter:blur(24px)}
  .cwar .hero .g>div:last-child::after{content:"";position:absolute;inset:-9%;z-index:-1;border-radius:50%;pointer-events:none;
    background:conic-gradient(from var(--aisa-a),rgba(233,210,155,0) 0deg,rgba(246,227,168,.9) 40deg,rgba(233,210,155,0) 110deg,rgba(233,210,155,0) 190deg,rgba(96,146,255,.85) 230deg,rgba(96,146,255,0) 300deg);
    -webkit-mask:radial-gradient(closest-side,transparent 97.2%,#000 98%,#000 99.4%,transparent 100%);mask:radial-gradient(closest-side,transparent 97.2%,#000 98%,#000 99.4%,transparent 100%);
    animation:aisaSpin 14s linear infinite}
  @keyframes aisaSpin{to{--aisa-a:360deg}}
  .cwar .hero .g>div:last-child .aisa-tilt3d{transform-style:preserve-3d}
  .cwar .hero .g>div:last-child img{transform:rotateY(-9deg) rotateX(4deg);transform-origin:50% 50%;will-change:transform;
    animation:aisaFloat 7s ease-in-out infinite;
    box-shadow:0 0 0 1px rgba(246,227,168,.35),0 2px 8px rgba(0,0,0,.35),0 40px 90px -25px rgba(0,0,0,.85),-26px 0 70px -40px rgba(96,146,255,.6),26px 0 70px -40px rgba(240,200,118,.55)}
  @keyframes aisaFloat{0%,100%{transform:rotateY(-9deg) rotateX(4deg) translateY(0)}50%{transform:rotateY(-9deg) rotateX(4deg) translateY(-12px)}}
  .aisa-sheen{position:absolute;pointer-events:none;overflow:hidden;border-radius:18px;z-index:2}
  .aisa-sheen i{position:absolute;top:-25%;bottom:-25%;left:0;width:36%;transform:translateX(-120%) skewX(-14deg);opacity:0;
    background:linear-gradient(100deg,rgba(255,244,214,0),rgba(255,244,214,.26) 50%,rgba(255,244,214,0))}
  @media (max-width:749px){
    .cwar .hero .g>div:last-child img{transform:rotateX(3deg);animation-name:aisaFloatM}
    @keyframes aisaFloatM{0%,100%{transform:rotateX(3deg) translateY(0)}50%{transform:rotateX(3deg) translateY(-8px)}}
    .cwar .hero .g>div:last-child::after{inset:-5%}
  }

  /* ── 2 · BUY BUTTONS: bold gold, readable, alive ───────── */
  .cwar .btn,.ab-btn:not(.ab-ghost){color:#0A1324!important;text-shadow:0 1px 0 rgba(255,255,255,.35);
    background:linear-gradient(180deg,#FCEBBA 0%,#EBC877 45%,#C99A45 100%)!important;
    box-shadow:inset 0 1px 0 rgba(255,255,255,.75),inset 0 -2px 0 rgba(120,80,20,.28),0 0 0 1px rgba(255,236,190,.55),0 12px 32px rgba(214,170,80,.45)!important;
    position:relative;overflow:hidden;isolation:isolate;-webkit-tap-highlight-color:transparent;
    transition:transform .18s cubic-bezier(.2,.8,.2,1),filter .25s ease}
  .cwar .btn{animation:aisaPulse 3.2s ease-in-out 2.4s infinite}
  @keyframes aisaPulse{0%,100%{box-shadow:inset 0 1px 0 rgba(255,255,255,.75),inset 0 -2px 0 rgba(120,80,20,.28),0 0 0 1px rgba(255,236,190,.55),0 12px 32px rgba(214,170,80,.45)}
    50%{box-shadow:inset 0 1px 0 rgba(255,255,255,.75),inset 0 -2px 0 rgba(120,80,20,.28),0 0 0 6px rgba(240,205,120,.22),0 16px 48px rgba(230,185,90,.7)}}
  .cwar .btn .p{background:rgba(10,19,36,.13)!important;color:#0A1324!important;font-variant-numeric:lining-nums tabular-nums}
  .cwar .btn .p s{color:rgba(10,19,36,.5)!important}
  .cwar .btn .aisa-bs{position:absolute;inset:0;z-index:-1;pointer-events:none;opacity:0;transform:translateX(-110%);
    background:linear-gradient(110deg,rgba(255,255,255,0) 30%,rgba(255,255,255,.6) 50%,rgba(255,255,255,0) 70%)}
  @media (hover:hover) and (pointer:fine){.cwar .btn:hover,.ab-btn:not(.ab-ghost):hover{transform:translateY(-2px);filter:saturate(1.1) brightness(1.03)}}
  .cwar .btn:active,.ab-btn:active{transform:translateY(0) scale(.97);transition-duration:.08s}
  .cwar .btn:focus-visible,.ab-btn:focus-visible{outline:3px solid #F2DFA9;outline-offset:3px}
  .cwar .sticky{background:rgba(6,12,24,.86)!important;-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);border-top:1px solid rgba(233,210,155,.28)!important}

  /* ── 3 · PREMIUM FINISH ON EVERY SECTION ───────────────── */
  .cwar section h2{font-size:clamp(29px,3.3vw,44px)!important;line-height:1.28!important}
  .cwar .pain,.cwar .out,.cwar .part,.cwar .ex .c,.cwar .who>div,.cwar .nada{border:1px solid rgba(201,164,92,.3)!important;border-radius:18px!important;
    box-shadow:0 1px 2px rgba(10,19,36,.05),0 14px 34px -18px rgba(10,19,36,.28)!important}
  .cwar .pain b,.cwar .out h3{letter-spacing:0}
  .cwar .out .n{background:linear-gradient(145deg,#F6E3A8,#C99A45)!important;color:#0A1324!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.6),0 4px 10px rgba(201,154,69,.35)}
  .cwar .part i{background:linear-gradient(180deg,#D9B25F,#9C7632);-webkit-background-clip:text;background-clip:text;color:transparent!important;font-weight:700;font-size:20px}
  .cwar .pages figure img{border-radius:12px!important;box-shadow:0 0 0 1px rgba(201,164,92,.35),0 24px 50px -20px rgba(10,19,36,.45)!important}
  .ab-why{position:relative;isolation:isolate}
  .ab-why .ab-st{background:linear-gradient(180deg,rgba(255,255,255,.07),rgba(255,255,255,.015))!important;border:1px solid rgba(233,210,155,.22)!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.06),0 20px 40px -24px rgba(0,0,0,.6)}
  .ab-why .ab-st b{background:linear-gradient(180deg,#FFF1C9,#E3BE6C 55%,#B98B3C);-webkit-background-clip:text;background-clip:text;color:transparent!important}

  /* offer card: living gold frame */
  .cwar .offer{background:#050B17 radial-gradient(60% 50% at 50% 30%,rgba(214,170,80,.18),rgba(214,170,80,0) 70%)!important}
  .cwar .offer .box{position:relative;isolation:isolate;box-shadow:0 40px 90px -20px rgba(0,0,0,.7),0 0 80px -20px rgba(233,198,116,.35)!important}
  .cwar .offer .box::after{content:"";position:absolute;inset:-2px;border-radius:24px;z-index:-1;pointer-events:none;
    background:conic-gradient(from var(--aisa-a),#B98B3C,#FCEBBA,#C99A45 25%,#6E92FF 40%,#C99A45 55%,#FCEBBA 75%,#B98B3C);animation:aisaSpin 9s linear infinite}
  .cwar .price{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:6px 12px}
  .cwar .price .save{margin:0!important}
  .cwar .price small{flex-basis:100%;text-align:center}
  .cwar .price .big,.cwar .ladder b{font-variant-numeric:lining-nums tabular-nums}
  .cwar .offer .ladder li{padding:11px 16px}
  .cwar .ladder .now{box-shadow:0 0 0 4px rgba(201,164,92,.18)}
  .cwar .ladder .now em{animation:aisaLive2 2.4s ease-out infinite}
  @keyframes aisaLive2{0%{box-shadow:0 0 0 0 rgba(201,164,92,.6)}80%,100%{box-shadow:0 0 0 8px rgba(201,164,92,0)}}

  @media (prefers-reduced-motion:reduce){
    .cwar .hero>.w::before,.cwar .hero .g>div:last-child::after,.cwar .hero .g>div:last-child img,.cwar .btn,.cwar .offer .box::after,.cwar .hero .eb::before,.cwar .ladder .now em,.cwar .hero h1 em{animation:none!important}
    .cwar .hero h1 em{background-position:0 0!important}
    .cwar .btn,.cwar .btn:hover,.cwar .btn:active{transition:none;transform:none}
    .aisa-sheen,.cwar .btn .aisa-bs{display:none}
  }
</style>
<script src="{{ 'aisa-gsap.min.js' | asset_url }}" defer></script>
<script>
  /* one orchestrated hero moment + desktop pointer tilt; fails silently if GSAP is missing */
  window.addEventListener('load', function () {
    setTimeout(function () {
      var g = window.gsap, box = document.querySelector('.cwar .hero .g>div:last-child'), img = box && box.querySelector('img');
      if (!g || !img || !g.matchMedia) return;
      var mm = g.matchMedia();
      mm.add({ ok: '(prefers-reduced-motion: no-preference)', fine: '(hover: hover) and (pointer: fine) and (min-width: 750px)' }, function (ctx) {
        if (!ctx.conditions.ok) return;
        var sh = document.createElement('span'); sh.className = 'aisa-sheen'; sh.setAttribute('aria-hidden', 'true');
        var bar = document.createElement('i'); sh.appendChild(bar);
        function fit() { sh.style.left = img.offsetLeft + 'px'; sh.style.top = img.offsetTop + 'px'; sh.style.width = img.offsetWidth + 'px'; sh.style.height = img.offsetHeight + 'px'; }
        fit(); box.appendChild(sh);
        var btn = document.querySelector('.cwar .hero .btn'), bs = null;
        if (btn) { bs = document.createElement('span'); bs.className = 'aisa-bs'; bs.setAttribute('aria-hidden', 'true'); btn.appendChild(bs); }
        var tl = g.timeline({ defaults: { ease: 'power2.out' } });
        tl.fromTo(box, { '--aisa-glow': 0.35 }, { '--aisa-glow': 1, duration: 1.4 }, 0)
          .to(bar, { opacity: 1, duration: 0.25 }, 0.25)
          .to(bar, { x: img.offsetWidth * 1.15, duration: 1.2, ease: 'power2.inOut' }, 0.25)
          .to(bar, { opacity: 0, duration: 0.3 }, 1.2);
        if (bs) tl.fromTo(bs, { xPercent: -110, opacity: 1 }, { xPercent: 110, duration: 0.8, ease: 'power2.inOut' }, 1.35).set(bs, { opacity: 0 });
        tl.eventCallback('onComplete', function () { sh.remove(); if (bs) bs.remove(); });
        var off = null;
        if (ctx.conditions.fine) {
          var stage = box.closest('.hero');
          g.set(box, { transformPerspective: 1400 });
          var rx = g.quickTo(box, 'rotationX', { duration: 0.8, ease: 'power3.out' }), ry = g.quickTo(box, 'rotationY', { duration: 0.8, ease: 'power3.out' });
          var move = function (e) { var r = stage.getBoundingClientRect(); var x = (e.clientX - r.left) / r.width - 0.5, y = (e.clientY - r.top) / r.height - 0.5; ry(x * 8); rx(-y * 6); };
          var leave = function () { rx(0); ry(0); };
          stage.addEventListener('pointermove', move, { passive: true }); stage.addEventListener('pointerleave', leave);
          off = function () { stage.removeEventListener('pointermove', move); stage.removeEventListener('pointerleave', leave); };
        }
        return function () { sh.remove(); if (bs) bs.remove(); if (off) off(); };
      });
    }, 300);
  });
</script>
{%- endif -%}
