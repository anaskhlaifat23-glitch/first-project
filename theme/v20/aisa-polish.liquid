{%- comment -%}
  AI Step Ahead · visual polish v20 (preview only). Scoped to the two Arabic sales pages.
  1) Cover depth + light   2) Offer card + heading finish   3) Button press/focus feedback
  Decorative only: no copy, links, prices, order or tracking touched. Content is fully visible without JS.
{%- endcomment -%}
{%- if page.handle == 'claude-arabic' or page.handle == 'chatgpt-arabic' -%}
<style id="aisa-polish">
  /* 1 · cover depth & light */
  .cwar .hero .g>div:last-child{position:relative;isolation:isolate;--aisa-glow:.85}
  .cwar .hero .g>div:last-child::before{content:"";position:absolute;inset:4% 2% 0;z-index:-1;border-radius:50%;pointer-events:none;
    background:radial-gradient(closest-side,rgba(233,210,155,.34),rgba(201,164,92,.13) 55%,rgba(201,164,92,0) 100%);filter:blur(30px);opacity:var(--aisa-glow)}
  .cwar .hero .g>div:last-child img{box-shadow:0 0 0 1px rgba(233,210,155,.16),0 2px 6px rgba(3,8,18,.28),0 22px 44px rgba(3,8,18,.42),0 60px 100px -30px rgba(3,8,18,.7)}
  .aisa-sheen{position:absolute;pointer-events:none;overflow:hidden;border-radius:18px}
  .aisa-sheen i{position:absolute;top:-25%;bottom:-25%;left:0;width:36%;transform:translateX(-120%) skewX(-14deg);opacity:0;
    background:linear-gradient(100deg,rgba(255,244,214,0),rgba(255,244,214,.22) 50%,rgba(255,244,214,0))}

  /* 2 · offer card & headings */
  .cwar h1,.cwar h2{text-wrap:balance}
  .cwar .offer .box{position:relative;box-shadow:0 0 0 1px rgba(201,164,92,.38),0 2px 6px rgba(3,8,18,.22),0 32px 72px -12px rgba(0,0,0,.55)}
  .cwar .offer .box::before{content:"";position:absolute;top:0;left:28px;right:28px;height:3px;border-radius:0 0 3px 3px;pointer-events:none;
    background:linear-gradient(90deg,rgba(201,164,92,0),#C9A45C 30%,#E9D29B 50%,#C9A45C 70%,rgba(201,164,92,0))}
  .cwar .price .big,.cwar .ladder b,.cwar .btn .p{font-variant-numeric:lining-nums tabular-nums}
  .cwar .ladder .now{box-shadow:0 0 0 4px rgba(201,164,92,.16)}

  /* 3 · buy-button feedback */
  .cwar .btn{position:relative;overflow:hidden;isolation:isolate;-webkit-tap-highlight-color:transparent;
    transition:transform .18s cubic-bezier(.2,.8,.2,1),box-shadow .25s ease,filter .25s ease}
  .cwar .btn .aisa-bs{position:absolute;inset:0;z-index:-1;pointer-events:none;opacity:0;transform:translateX(-110%);
    background:linear-gradient(110deg,rgba(255,255,255,0) 30%,rgba(255,255,255,.45) 50%,rgba(255,255,255,0) 70%)}
  @media (hover:hover) and (pointer:fine){
    .cwar .btn:hover{transform:translateY(-2px);box-shadow:0 16px 36px rgba(201,164,92,.45);filter:saturate(1.08)}
  }
  .cwar .btn:active{transform:translateY(0) scale(.97);box-shadow:0 6px 16px rgba(201,164,92,.35);transition-duration:.08s}
  .cwar .btn:focus-visible,.cwar .ab-btn:focus-visible{outline:3px solid #F2DFA9;outline-offset:3px}
  .cwar .ab-btn:active{transform:scale(.97)}

  @media (prefers-reduced-motion:reduce){
    .cwar .btn,.cwar .btn:hover,.cwar .btn:active{transition:none;transform:none}
    .aisa-sheen,.cwar .btn .aisa-bs{display:none}
  }
</style>
<script src="{{ 'aisa-gsap.min.js' | asset_url }}" defer></script>
<script>
  /* one orchestrated hero moment after the page has painted; fails silently if GSAP is missing */
  window.addEventListener('load', function () {
    setTimeout(function () {
      var g = window.gsap, box = document.querySelector('.cwar .hero .g>div:last-child'), img = box && box.querySelector('img');
      if (!g || !img || !g.matchMedia) return;
      var mm = g.matchMedia();
      mm.add('(prefers-reduced-motion: no-preference)', function () {
        var sh = document.createElement('span'); sh.className = 'aisa-sheen'; sh.setAttribute('aria-hidden', 'true');
        var bar = document.createElement('i'); sh.appendChild(bar);
        function fit() { sh.style.left = img.offsetLeft + 'px'; sh.style.top = img.offsetTop + 'px'; sh.style.width = img.offsetWidth + 'px'; sh.style.height = img.offsetHeight + 'px'; }
        fit(); box.appendChild(sh);
        var btn = document.querySelector('.cwar .hero .btn'), bs = null;
        if (btn) { bs = document.createElement('span'); bs.className = 'aisa-bs'; bs.setAttribute('aria-hidden', 'true'); btn.appendChild(bs); }
        var tl = g.timeline({ defaults: { ease: 'power2.out' } });
        tl.fromTo(box, { '--aisa-glow': 0.55 }, { '--aisa-glow': 1, duration: 1.4 }, 0)
          .to(bar, { opacity: 1, duration: 0.25 }, 0.2)
          .to(bar, { x: img.offsetWidth * 1.15, duration: 1.2, ease: 'power2.inOut' }, 0.2)
          .to(bar, { opacity: 0, duration: 0.3 }, 1.15);
        if (bs) tl.fromTo(bs, { xPercent: -110, opacity: 1 }, { xPercent: 110, duration: 0.8, ease: 'power2.inOut' }, 1.3).set(bs, { opacity: 0 });
        tl.eventCallback('onComplete', function () { sh.remove(); if (bs) bs.remove(); });
        return function () { sh.remove(); if (bs) bs.remove(); };
      });
    }, 400);
  });
</script>
{%- endif -%}
