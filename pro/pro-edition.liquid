@font-face{font-family:"ProNaskh";font-weight:500;font-display:swap;src:url("{{ 'pro-naskh-500.woff2' | asset_url }}") format("woff2")}
@font-face{font-family:"ProPlex";font-weight:400;font-display:swap;src:url("{{ 'pro-plex-400.woff2' | asset_url }}") format("woff2")}
@font-face{font-family:"ProPlex";font-weight:600;font-display:swap;src:url("{{ 'pro-plex-600.woff2' | asset_url }}") format("woff2")}
@font-face{font-family:"ProPlex";font-weight:400;font-display:swap;unicode-range:U+0000-00FF,U+2000-206F;src:url("{{ 'pro-plexl-400.woff2' | asset_url }}") format("woff2")}
@font-face{font-family:"ProPlex";font-weight:600;font-display:swap;unicode-range:U+0000-00FF,U+2000-206F;src:url("{{ 'pro-plexl-600.woff2' | asset_url }}") format("woff2")}
.pro{--iv:#F5F0E6;--pa:#FBF8F2;--ink:#1C1D21;--ink2:#4B4E56;--mu:#8A8476;--ln:#E2D9C8;--br:#9A7848;--br2:#C9AB7C;--ch:#17181B;
 direction:rtl;font-family:"ProPlex",system-ui,sans-serif;color:var(--ink);background:var(--pa);font-size:17px;line-height:1.9;-webkit-font-smoothing:antialiased;overflow-x:hidden}
.pro *{box-sizing:border-box}
.pro img{max-width:100%;height:auto;display:block}
.pro h1,.pro h2,.pro h3{font-family:"ProNaskh",serif;font-weight:700;line-height:1.45;margin:0;color:var(--ch);letter-spacing:0}
.pro p{margin:0 0 14px}
.pro a{color:inherit}
.pro .en{direction:ltr;unicode-bidi:isolate}
.pro .wrap{max-width:1120px;margin:0 auto;padding:0 22px}
.pro .narrow{max-width:760px}
.pro .eyebrow{font-size:13px;font-weight:600;color:var(--br);letter-spacing:.02em;margin-bottom:14px;display:block}
.pro section{padding:76px 0;border-top:1px solid var(--ln)}
.pro section:first-of-type{border-top:0}
.pro h2{font-size:clamp(27px,4.4vw,40px);margin-bottom:18px}
.pro .lead{font-size:clamp(17px,2.1vw,19.5px);color:var(--ink2);max-width:640px}
/* top bar */
.pro .bar{position:sticky;top:0;z-index:20;background:rgba(251,248,242,.92);backdrop-filter:blur(8px);border-bottom:1px solid var(--ln)}
.pro .bar .wrap{display:flex;align-items:center;justify-content:space-between;height:60px}
.pro .logo{font-weight:600;font-size:15px;letter-spacing:.02em;display:flex;align-items:center;gap:10px}
.pro .logo i{width:18px;height:18px;border:1.4px solid var(--br);border-radius:50%;display:inline-block;position:relative}
.pro .logo i:after{content:"";position:absolute;inset:4px;border:1.2px solid var(--br);transform:rotate(45deg)}
.pro .bar .mini{font-size:14px;text-decoration:none;border:1px solid var(--ch);padding:7px 16px;border-radius:999px}
/* buttons */
.pro .btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;background:var(--ch);color:#F5EEDF;text-decoration:none;font-weight:600;font-size:17px;padding:16px 30px;border-radius:999px;border:0;cursor:pointer;transition:background .25s}
.pro .btn:hover{background:#2C2D32}
.pro .btn.ghost{background:transparent;color:var(--ch);border:1px solid var(--ch)}
.pro .btn[aria-disabled=true]{background:#8E8A82;cursor:not-allowed}
.pro .fine{font-size:13.5px;color:var(--mu)}
/* hero */
.pro .hero{padding:64px 0 70px;background:var(--pa)}
.pro .hero .grid{display:grid;grid-template-columns:1.05fr .95fr;gap:56px;align-items:center}
.pro .hero h1{font-size:clamp(34px,5vw,52px);line-height:1.4}
.pro .hero h1 em{font-style:normal;color:var(--br)}
.pro .hero .lead{margin:22px 0 30px}
.pro .hero .ctas{display:flex;flex-wrap:wrap;gap:12px;align-items:center}
.pro .hero .assure{margin-top:22px;display:flex;flex-wrap:wrap;gap:8px 20px;font-size:14px;color:var(--ink2)}
.pro .hero .assure span:before{content:"";display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--br2);margin-left:8px;vertical-align:middle}
.pro .stage{position:relative;aspect-ratio:1/1;background:radial-gradient(120% 90% at 30% 20%,#EFE7D7 0%,#E6DCC8 60%,#DCCFB7 100%);border-radius:6px;overflow:hidden}
.pro .stage img{position:absolute;box-shadow:0 30px 60px -20px rgba(40,30,15,.35),0 2px 6px rgba(40,30,15,.12);border-radius:2px;background:#fff}
.pro .stage .p1{width:52%;top:11%;right:9%;transform:rotate(2.2deg)}
.pro .stage .p2{width:52%;top:20%;right:40%;transform:rotate(-3deg)}
.pro .stage .p3{width:34%;bottom:7%;right:22%;transform:rotate(-1deg)}
.pro .stage figcaption{position:absolute;bottom:12px;left:14px;font-size:12px;color:#6F6758}
/* cost */
.pro .cost{background:var(--iv)}
.pro .three{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:36px}
.pro .card{background:#fff;border:1px solid var(--ln);border-radius:6px;padding:26px}
.pro .card .n{font-family:"ProNaskh";color:var(--br);font-size:22px;margin-bottom:6px}
.pro .card h3{font-size:21px;margin-bottom:10px}
.pro .card p{color:var(--ink2);font-size:16px;margin:0}
.pro .pull{margin-top:40px;font-family:"ProNaskh";font-size:clamp(21px,2.8vw,27px);line-height:1.7;color:var(--ch);max-width:820px;border-right:3px solid var(--br2);padding-right:22px}
/* transformation */
.pro .vs{display:grid;grid-template-columns:1fr 1fr;gap:0;margin-top:34px;border:1px solid var(--ln);border-radius:6px;overflow:hidden;background:#fff}
.pro .vs > div{padding:28px}
.pro .vs .a{background:#F0EBE2;color:var(--ink2)}
.pro .vs h3{font-size:19px;margin-bottom:14px}
.pro .vs .a h3{color:var(--mu)}
.pro .vs ul{list-style:none;margin:0;padding:0}
.pro .vs li{padding:12px 0;border-top:1px solid var(--ln);font-size:16px}
.pro .vs li:first-child{border-top:0}
.pro .vs .b li b{color:var(--br);font-weight:600}
.pro .prompts{display:grid;grid-template-columns:1fr 1.25fr;gap:20px;margin-top:30px;align-items:start}
.pro .pbox{border-radius:6px;padding:22px 24px;font-size:15.5px;line-height:2}
.pro .pbox.weak{background:#EDE8DF;color:var(--ink2)}
.pro .pbox.strong{background:var(--ch);color:#EAE2D2}
.pro .pbox .t{font-size:12.5px;font-weight:600;letter-spacing:.02em;margin-bottom:10px;display:block}
.pro .pbox.weak .t{color:var(--mu)}
.pro .pbox.strong .t{color:var(--br2)}
.pro .pbox .m{color:var(--br2);font-weight:600}
.pro .pbox .ph{background:#34312B;color:#F2D7A6;border-radius:3px;padding:0 5px}
/* method */
.pro .method{background:var(--ch);color:#E9E1D1;border-top:0}
.pro .method h2{color:#F6F0E4}
.pro .method .lead{color:#BDB3A1}
.pro .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#34322D;margin-top:40px;border-radius:6px;overflow:hidden}
.pro .steps > div{background:#1E1F23;padding:30px 26px}
.pro .steps .k{font-family:"ProNaskh";font-size:44px;color:var(--br2);line-height:1}
.pro .steps h3{color:#F4EDE0;font-size:22px;margin:14px 0 10px}
.pro .steps p{color:#B9AF9E;font-size:15.5px;margin:0}
.pro .steps .chips{margin-top:14px;display:flex;flex-wrap:wrap;gap:6px}
.pro .steps .chips span{font-size:12.5px;border:1px solid #45423B;color:#D9CDB6;border-radius:999px;padding:2px 10px}
.pro .levels{display:flex;flex-wrap:wrap;gap:14px;margin-top:26px;font-size:14.5px;color:#BDB3A1}
.pro .levels b{color:#F4EDE0;font-weight:600}
.pro .dot{display:inline-block;width:9px;height:9px;border-radius:50%;margin-left:7px}
/* inside */
.pro .gallery{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:36px}
.pro .gallery figure{margin:0}
.pro .gallery img{border:1px solid var(--ln);border-radius:3px;box-shadow:0 14px 30px -18px rgba(40,30,15,.35);background:#fff;cursor:zoom-in}
.pro .gallery figcaption{font-size:13.5px;color:var(--ink2);margin-top:10px;line-height:1.6}
.pro .gallery figcaption b{display:block;color:var(--ch)}
.pro .wflist{columns:2;column-gap:40px;margin:28px 0 0;padding:0;list-style:none}
.pro .wflist li{break-inside:avoid;padding:9px 0;border-bottom:1px solid var(--ln);font-size:15.5px;display:flex;gap:12px}
.pro .wflist li span{color:var(--br);font-family:"ProNaskh";min-width:26px}
/* package */
.pro .pkg{background:var(--iv)}
.pro .items{margin-top:34px;border-top:1px solid var(--ch)}
.pro .item{display:grid;grid-template-columns:64px 1fr 1.1fr;gap:22px;padding:24px 0;border-bottom:1px solid var(--ln);align-items:start}
.pro .item .no{font-family:"ProNaskh";font-size:28px;color:var(--br2);line-height:1.2}
.pro .item h3{font-size:20px}
.pro .item .what{font-size:14px;color:var(--mu);margin-top:4px}
.pro .item p{margin:0;color:var(--ink2);font-size:16px}
/* trust */
.pro .trust .grid2{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin-top:30px}
.pro .trust .card h3{font-size:19px}
.pro .honest{margin-top:22px;background:#fff;border:1px dashed var(--br2);border-radius:6px;padding:20px 24px;color:var(--ink2);font-size:15.5px}
/* price */
.pro .price .box{display:grid;grid-template-columns:1.1fr .9fr;gap:0;border:1px solid var(--ch);border-radius:6px;overflow:hidden;margin-top:30px;background:#fff}
.pro .price .l{padding:34px}
.pro .price .r{padding:34px;background:var(--ch);color:#EDE5D5;display:flex;flex-direction:column;justify-content:center}
.pro .price .amt{font-family:"ProNaskh";font-size:56px;color:#F6EFE2;line-height:1.1}
.pro .price .amt small{font-size:18px;color:var(--br2);margin-right:8px;font-family:"ProPlex"}
.pro .price .r .btn{background:#F3EBDB;color:var(--ch);margin-top:22px}
.pro .price .r .fine{color:#A9A08F;margin-top:14px}
.pro .ticks{list-style:none;padding:0;margin:0}
.pro .ticks li{padding:8px 30px 8px 0;position:relative;font-size:16px;border-bottom:1px solid var(--ln)}
.pro .ticks li:before{content:"";position:absolute;right:2px;top:17px;width:12px;height:7px;border-left:1.6px solid var(--br);border-bottom:1.6px solid var(--br);transform:rotate(-45deg)}
.pro .why3{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:26px}
.pro .why3 div{font-size:15.5px;color:var(--ink2);border-top:2px solid var(--br2);padding-top:12px}
.pro .why3 b{display:block;color:var(--ch);font-weight:600;margin-bottom:4px}
.pro .alt{margin-top:22px;font-size:15px;color:var(--ink2)}
/* faq */
.pro details{border-bottom:1px solid var(--ln);padding:18px 0}
.pro summary{cursor:pointer;font-weight:600;font-size:17.5px;list-style:none;display:flex;justify-content:space-between;gap:16px}
.pro summary::-webkit-details-marker{display:none}
.pro summary:after{content:"+";color:var(--br);font-size:22px;line-height:1}
.pro details[open] summary:after{content:"–"}
.pro details p{margin:12px 0 0;color:var(--ink2);font-size:16px}
/* footer */
.pro .foot{background:var(--ch);color:#9E9584;font-size:14px;padding:40px 0;border-top:0}
.pro .foot a{color:#D9CDB6}
.pro .foot .row{display:flex;flex-wrap:wrap;gap:10px 26px;justify-content:space-between}
/* preview ribbon */
.pro .ribbon{background:#7A3B2E;color:#fff;font-size:13.5px;text-align:center;padding:8px 14px;display:none}
.pro.is-preview .ribbon{display:block}
/* sticky buy (mobile) */
.pro .sbuy{position:fixed;bottom:0;left:0;right:0;z-index:30;background:rgba(23,24,27,.97);color:#EFE7D8;display:none;align-items:center;justify-content:space-between;gap:12px;padding:12px 18px calc(12px + env(safe-area-inset-bottom))}
.pro .sbuy .btn{padding:12px 22px;font-size:15.5px;background:#F3EBDB;color:var(--ch)}
.pro .sbuy b{font-family:"ProNaskh";font-size:22px;color:#F6EFE2}
.pro .sbuy span{font-size:12.5px;color:#A9A08F;display:block}
/* reveal */
.pro .rv{opacity:0;transform:translateY(14px);transition:opacity .7s ease,transform .7s ease}
.pro .rv.in{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){.pro .rv{opacity:1;transform:none;transition:none}}
/* lightbox */
.pro .lb{position:fixed;inset:0;background:rgba(20,18,15,.88);z-index:50;display:none;align-items:center;justify-content:center;padding:20px}
.pro .lb.on{display:flex}
.pro .lb img{max-height:92vh;width:auto;border-radius:3px}
@media (max-width:900px){
 .pro{font-size:16.5px}
 .pro section{padding:58px 0}
 .pro .hero{padding:34px 0 50px}
 .pro .hero .grid{grid-template-columns:1fr;gap:34px}
 .pro .hero .stage{aspect-ratio:1/1}
 .pro .stage .p1{width:60%;right:6%}
 .pro .stage .p2{width:60%;right:34%}
 .pro .stage .p3{width:40%}
 .pro .three,.pro .steps,.pro .why3,.pro .trust .grid2{grid-template-columns:1fr}
 .pro .vs{grid-template-columns:1fr}
 .pro .prompts{grid-template-columns:1fr}
 .pro .gallery{grid-template-columns:1fr 1fr}
 .pro .wflist{columns:1}
 .pro .item{grid-template-columns:44px 1fr;gap:6px 14px}
 .pro .item p{grid-column:2}
 .pro .price .box{grid-template-columns:1fr}
 .pro .price .l,.pro .price .r{padding:26px}
 .pro .sbuy{display:flex;transform:translateY(110%);transition:transform .35s ease}
 .pro .sbuy.on{transform:none}
 .pro .foot{padding-bottom:110px}
 .pro .btn{width:100%}
 .pro .hero .ctas .btn.ghost{display:none}
 .pro .bar .mini{display:none}
}
</style>

