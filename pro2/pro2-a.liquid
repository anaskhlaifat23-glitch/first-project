<!--PRO2-START-->
<style>
@font-face{font-family:"AMarkazi";font-weight:600;font-display:swap;src:url("{{ 'pro2-markazi-600.woff2' | asset_url }}") format("woff2")}
@font-face{font-family:"AMarkazi";font-weight:700;font-display:swap;src:url("{{ 'pro2-markazi-700.woff2' | asset_url }}") format("woff2")}
@font-face{font-family:"AMarkazi";font-weight:600;font-display:swap;unicode-range:U+0000-00FF;src:url("{{ 'pro2-markazil-600.woff2' | asset_url }}") format("woff2")}
@font-face{font-family:"APlex";font-weight:400;font-display:swap;src:url("{{ 'pro-plex-400.woff2' | asset_url }}") format("woff2")}
@font-face{font-family:"APlex";font-weight:600;font-display:swap;src:url("{{ 'pro-plex-600.woff2' | asset_url }}") format("woff2")}
@font-face{font-family:"APlex";font-weight:400;font-display:swap;unicode-range:U+0000-00FF,U+2000-206F,U+2190-21FF;src:url("{{ 'pro-plexl-400.woff2' | asset_url }}") format("woff2")}
@font-face{font-family:"APlex";font-weight:600;font-display:swap;unicode-range:U+0000-00FF,U+2000-206F,U+2190-21FF;src:url("{{ 'pro-plexl-600.woff2' | asset_url }}") format("woff2")}
@font-face{font-family:"AMono";font-weight:400;font-display:swap;src:url("{{ 'pro2-mono-400.woff2' | asset_url }}") format("woff2")}

/* ---------- tokens ---------- */
.L{--paper:#F7F6F3;--stone:#ECEAE5;--stage:#E6E4DF;--ink:#121317;--ink2:#474B54;--mute:#6B6E75;--rule:#D9D6CF;--red:#B42318;--green:#1F5E46;
 --s1:8px;--s2:16px;--s3:24px;--s4:40px;--s5:64px;--s6:104px;--s7:160px;
 --wrap:1320px;--gut:32px;--side:clamp(20px,4vw,56px);
 direction:rtl;background:var(--paper);color:var(--ink);font-family:"APlex",system-ui,sans-serif;font-size:18px;line-height:1.85;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
.L *{box-sizing:border-box}
.L img{display:block;max-width:100%;height:auto}
.L a{color:inherit}
.L p{margin:0 0 var(--s2)}
.L h1,.L h2,.L h3{font-family:"AMarkazi",serif;font-weight:700;margin:0;letter-spacing:0;color:var(--ink)}
.L .mono{font-family:"AMono",ui-monospace,monospace;direction:ltr;unicode-bidi:isolate;letter-spacing:.02em}
.L .en{direction:ltr;unicode-bidi:isolate}
.L .wrap{max-width:var(--wrap);margin:0 auto;padding:0 var(--side)}
.L .kick{font-size:13px;color:var(--mute);display:flex;gap:14px;align-items:center;margin-bottom:var(--s3)}
.L .kick .mono{color:var(--ink)}
.L .kick:before{content:"";width:28px;height:1px;background:var(--ink)}
.L .rule{height:1px;background:var(--ink);border:0;margin:0}
.L .btn{display:inline-flex;align-items:center;gap:14px;height:58px;padding:0 30px;background:var(--ink);color:#F7F6F3;text-decoration:none;font-weight:600;font-size:17px;border-radius:2px;transition:background .25s,transform .25s}
.L .btn:hover{background:#2a2c33}
.L .btn:focus-visible,.L a:focus-visible,.L button:focus-visible,.L summary:focus-visible{outline:2px solid var(--red);outline-offset:3px}
.L .btn .ar{font-family:"APlex";transition:transform .25s}
.L .btn:hover .ar{transform:translateX(-4px)}
.L .btn[aria-disabled=true]{background:#8D8F94;cursor:not-allowed}
.L .lnk{font-weight:600;text-decoration:none;border-bottom:1px solid var(--ink);padding-bottom:2px}
.L figure{margin:0}
.L figcaption{font-size:13px;color:var(--mute);margin-top:12px;display:flex;gap:10px}
.L figcaption .mono{color:var(--ink)}
/* ---------- preview ribbon ---------- */
.L .rib{display:none;background:var(--red);color:#fff;font-size:13px;text-align:center;padding:7px 14px}
.L.is-preview .rib{display:block}
/* ---------- masthead ---------- */
.L .mast{position:sticky;top:0;z-index:40;background:rgba(247,246,243,.94);backdrop-filter:saturate(1.2) blur(10px);border-bottom:1px solid var(--rule)}
.L .mast .wrap{height:64px;display:flex;align-items:center;justify-content:space-between}
.L .brand{font-weight:600;font-size:15px;letter-spacing:.01em}
.L .brand small{font-weight:400;color:var(--mute);margin-right:10px}
.L .mast .buy{font-size:14px;font-weight:600;text-decoration:none;display:flex;gap:14px;align-items:center}
.L .mast .buy .p{color:var(--mute);font-weight:400}
.L .mast .buy b{background:var(--ink);color:#fff;padding:8px 16px;border-radius:2px;font-weight:600}
/* ---------- hero ---------- */
.L .hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr)}
.L .hero .txt{padding:var(--s5) var(--side) var(--s5) var(--s5);display:flex;flex-direction:column;justify-content:center;max-width:680px;margin-right:max(0px,calc((100vw - var(--wrap))/2))}
.L .hero h1{font-size:clamp(38px,3.9vw,60px);line-height:1.2;font-weight:700}
.L .hero h1 span{display:block;color:var(--ink2);font-weight:600;margin-top:6px}
.L .hero .sub{font-size:clamp(17px,1.35vw,20px);color:var(--ink2);margin:var(--s4) 0 var(--s4);max-width:540px}
.L .hero .meta{margin-top:var(--s3);font-size:13.5px;color:var(--mute);display:flex;flex-wrap:wrap;gap:6px 18px}
.L .hero .meta span+span:before{content:"·";margin-left:18px;color:var(--rule)}
.L .hero .img{background:var(--stage);position:relative;overflow:hidden;aspect-ratio:1/1;max-height:calc(100vh - 64px);min-height:560px}
.L .hero .img picture,.L .hero .img img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 50%}
.L .hero .img .cap{position:absolute;right:var(--s3);bottom:var(--s3);font-size:12.5px;color:#6E7076;background:rgba(247,246,243,.8);padding:4px 10px}
/* ---------- tension ---------- */
.L .tension{padding:var(--s7) 0 var(--s6)}
.L .tension h2{font-size:clamp(34px,4.4vw,64px);line-height:1.2;max-width:15ch}
.L .tension h2 em{font-style:normal;color:var(--red)}
.L .tgrid{display:grid;grid-template-columns:minmax(0,4fr) minmax(0,7fr);gap:var(--s5);margin-top:var(--s5);align-items:start}
.L .clock{font-family:"AMono";font-size:15px;color:var(--ink);direction:ltr;text-align:right}
.L .story p{color:var(--ink2);font-size:17.5px}
.L .story .clock{margin-bottom:var(--s2)}
.L .story ul{list-style:none;padding:0;margin:var(--s3) 0 0;border-top:1px solid var(--rule)}
.L .story li{padding:12px 0;border-bottom:1px solid var(--rule);font-size:15.5px;color:var(--ink2)}
.L .story li b{color:var(--ink);font-weight:600}
.L .sheet{background:#fff;border:1px solid var(--rule);padding:var(--s4) var(--s4) var(--s3);box-shadow:0 40px 60px -40px rgba(30,25,15,.35)}
.L .sheet .hd{display:flex;justify-content:space-between;font-size:12.5px;color:var(--mute);border-bottom:1px solid var(--rule);padding-bottom:10px;margin-bottom:var(--s3)}
.L .draft{font-size:clamp(17px,1.5vw,20px);line-height:2.3;color:var(--ink)}
.L .mk{border-bottom:2px solid var(--red);padding-bottom:1px}
.L .mk i{font-style:normal;font-family:"AMono";font-size:11px;color:#fff;background:var(--red);border-radius:50%;display:inline-block;width:19px;height:19px;line-height:19px;text-align:center;vertical-align:super;margin-right:3px}
.L .notes{list-style:none;padding:0;margin:var(--s3) 0 0;counter-reset:n}
.L .notes li{display:grid;grid-template-columns:28px 1fr;gap:12px;padding:11px 0;border-top:1px solid var(--rule);font-size:15px;color:var(--ink2);line-height:1.7}
.L .notes li:before{counter-increment:n;content:counter(n);font-family:"AMono";font-size:11px;color:#fff;background:var(--red);border-radius:50%;width:20px;height:20px;line-height:20px;text-align:center;margin-top:3px}
.L .notes b{color:var(--red);font-weight:600}
/* ---------- transformation ---------- */
.L .flow{background:var(--stone);padding:var(--s6) 0}
.L .flow h2{font-size:clamp(32px,3.8vw,56px);line-height:1.2;max-width:20ch}
.L .flow .lead{color:var(--ink2);max-width:640px;margin-top:var(--s3)}
.L .steps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin-top:var(--s5);border-top:1px solid var(--ink)}
.L .step{padding:var(--s3) var(--s3) var(--s3) var(--s3);border-left:1px solid var(--rule);min-width:0}
.L .step:last-child{border-left:0}
.L .step .no{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:var(--s3)}
.L .step .no .mono{font-size:13px}
.L .step .no b{font-family:"AMarkazi";font-size:26px;font-weight:700}
.L .step .doc{background:#fff;border:1px solid var(--rule);padding:18px;font-size:13.5px;line-height:1.75;min-height:290px}
.L .step .doc.req{background:var(--ink);color:#E8E6E1;border-color:var(--ink)}
.L .step p.d{font-size:14.5px;color:var(--ink2);margin-top:var(--s2)}
.L table.mini{width:100%;border-collapse:collapse;font-size:12.5px}
.L table.mini td{padding:5px 0;border-bottom:1px solid #EEE;white-space:nowrap}
.L table.mini td.n{font-family:"AMono";direction:ltr;text-align:left}
.L table.mini tr.t td{font-weight:600;border-top:1px solid var(--ink);border-bottom:1px solid var(--ink)}
.L .neg{color:var(--red)}.L .pos{color:var(--green)}
.L .req{background:var(--ink);color:#E8E6E1;border:0}
.L .req .m{color:#E9B8B2;font-weight:600}
.L .req .ph{background:#33353B;color:#F3D9A8;padding:0 4px}
.L .log div{display:grid;grid-template-columns:1fr auto;gap:8px;padding:6px 0;border-bottom:1px solid #EEE}
.L .log .ok{color:var(--green);font-weight:600;white-space:nowrap}
.L .log .tag{font-family:"AMono";font-size:11px;color:var(--mute)}
.L .memo h5{font-family:"AMarkazi";font-size:17px;margin:8px 0 2px}
.L .memo .st{display:inline-block;margin-top:10px;border:1px solid var(--green);color:var(--green);font-size:11.5px;font-weight:600;padding:2px 8px}
/* ---------- system ---------- */
.L .system{padding:var(--s7) 0 var(--s6)}
.L .system h2{font-size:clamp(32px,3.8vw,56px);max-width:18ch;line-height:1.2}
.L .chain{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin-top:var(--s5);border-top:1px solid var(--ink)}
.L .chain > div{padding:var(--s4) 0 var(--s3) var(--s4);position:relative}
.L .chain > div + div{padding-right:var(--s4);border-right:1px solid var(--rule)}
.L .chain .big{font-family:"AMarkazi";font-weight:700;font-size:clamp(40px,4.4vw,68px);line-height:1}
.L .chain .q{font-size:15.5px;color:var(--ink2);margin-top:var(--s2);max-width:34ch}
.L .ruler{display:flex;justify-content:space-between;margin-top:var(--s3);border-top:1px solid var(--ink);padding-top:10px;font-size:13px}
.L .ruler span{position:relative;padding-top:6px}
.L .ruler span:before{content:"";position:absolute;top:-16px;right:50%;width:1px;height:10px;background:var(--ink)}
.L .letters{display:flex;gap:10px;margin-top:var(--s3)}
.L .letters span{flex:1;border:1px solid var(--ink);text-align:center;padding:8px 0 6px;font-size:13px;line-height:1.4}
.L .letters b{display:block;font-family:"AMarkazi";font-size:26px}
.L .loop{display:flex;align-items:center;gap:10px;margin-top:var(--s3);font-size:14px;color:var(--ink2)}
.L .loop svg{flex:0 0 auto}
.L .risk{margin-top:var(--s5);display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0}
.L .risk div{padding:14px 0 0;border-top:4px solid;font-size:15px;color:var(--ink2);padding-left:var(--s3)}
.L .risk b{display:block;color:var(--ink);font-weight:600;margin-bottom:2px}
/* ---------- reveal ---------- */
.L .reveal{background:var(--stone);padding:var(--s6) 0 var(--s6)}
.L .reveal .head{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:var(--s5);align-items:end}
.L .reveal h2{font-size:clamp(40px,5.4vw,84px);line-height:1.08}
.L .reveal .head p{color:var(--ink2);font-size:18px;margin:0}
.L .reveal figure{margin-top:var(--s5)}
.L .index{margin-top:var(--s5);display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:var(--s5);border-top:1px solid var(--ink)}
.L .index .r{display:grid;grid-template-columns:52px minmax(0,1fr) auto;gap:18px;padding:20px 0;border-bottom:1px solid var(--rule);align-items:baseline}
.L .index .r .mono{font-size:14px}
.L .index h3{font-size:22px;line-height:1.35}
.L .index p{font-size:14.5px;color:var(--ink2);margin:4px 0 0;line-height:1.7}
.L .index .f{font-size:12.5px;color:var(--mute);white-space:nowrap;font-family:"AMono";direction:ltr}
.L .compare{margin-top:var(--s6);display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:var(--s5);align-items:start}
.L .compare h3{font-size:clamp(28px,2.8vw,40px);line-height:1.25}
.L .compare p{color:var(--ink2)}
.L table.cmp{width:100%;border-collapse:collapse;font-size:15.5px;background:#fff}
.L table.cmp th{font-weight:600;text-align:right;padding:16px 18px;border-bottom:1px solid var(--ink);font-size:14px}
.L table.cmp th:nth-child(3){background:var(--ink);color:#fff}
.L table.cmp td{padding:13px 18px;border-bottom:1px solid var(--rule);vertical-align:top}
.L table.cmp td:nth-child(2),.L table.cmp td:nth-child(3),.L table.cmp th:nth-child(2),.L table.cmp th:nth-child(3){text-align:center;width:22%}
.L table.cmp td:nth-child(3){background:#FAFAF8}
.L .y{color:var(--green);font-weight:600}.L .x{color:#B9BBC0}
/* ---------- explorer ---------- */
.L .explore{padding:var(--s7) 0 var(--s6)}
.L .explore h2{font-size:clamp(32px,3.8vw,56px);line-height:1.2;max-width:20ch}
.L .explore .lead{color:var(--ink2);max-width:620px;margin-top:var(--s3)}
.L .ex{display:grid;grid-template-columns:minmax(0,4fr) minmax(0,8fr);gap:0;margin-top:var(--s5);border-top:1px solid var(--ink)}
.L .ex .list{list-style:none;margin:0;padding:0;border-left:1px solid var(--rule)}
.L .ex .list button{all:unset;cursor:pointer;display:grid;grid-template-columns:34px 1fr;gap:10px;width:100%;box-sizing:border-box;padding:13px 0 13px 18px;border-bottom:1px solid var(--rule);font-size:15.5px;color:var(--ink2);line-height:1.5}
.L .ex .list button .mono{font-size:12.5px;color:var(--mute);padding-top:3px}
.L .ex .list button[aria-selected=true]{color:var(--ink);font-weight:600}
.L .ex .list button[aria-selected=true] .mono{color:var(--red)}
.L .ex .panel{padding:var(--s4) var(--s5) var(--s4) 0}
.L .ex .panel .w{color:var(--ink2);font-size:15.5px;margin-bottom:var(--s3)}
.L .ex .panel h3{font-size:30px;margin-bottom:6px}
.L .ex .lv{font-size:12.5px;font-weight:600;padding:2px 10px;border-radius:2px;color:#fff;margin-right:8px;vertical-align:middle}
.L .ex .rq{background:var(--ink);color:#E8E6E1;padding:var(--s4);font-size:15.5px;line-height:2}
.L .ex .rq .m{color:#E9B8B2;font-weight:600;margin-left:6px}
.L .ex .rq .ph{background:#33353B;color:#F3D9A8;padding:0 5px}
.L .ex .rq .bar{display:flex;justify-content:space-between;font-size:12.5px;color:#9EA1A8;border-bottom:1px solid #2E3036;padding-bottom:10px;margin-bottom:14px}
.L .ex .vf{margin-top:var(--s3);list-style:none;padding:0}
.L .ex .vf li{padding:10px 30px 10px 0;border-bottom:1px solid var(--rule);font-size:15px;color:var(--ink2);position:relative;line-height:1.7}
.L .ex .vf li:before{content:"";position:absolute;right:4px;top:17px;width:11px;height:6px;border-left:2px solid var(--green);border-bottom:2px solid var(--green);transform:rotate(-45deg)}
.L .ex select{display:none}
/* ---------- publisher ---------- */
.L .pub{border-top:1px solid var(--ink);padding:var(--s6) 0}
.L .pub .g{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:var(--s5)}
.L .pub h2{font-size:clamp(28px,3vw,44px);line-height:1.25}
.L .pub dl{margin:0;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:var(--s4) var(--s5)}
.L .pub dt{font-family:"AMarkazi";font-weight:700;font-size:22px;margin-bottom:6px}
.L .pub dd{margin:0;color:var(--ink2);font-size:15.5px;line-height:1.8}
/* ---------- offer ---------- */
.L .offer{background:var(--ink);color:#EDEBE6;padding:var(--s6) 0}
.L .offer .g{display:grid;grid-template-columns:minmax(0,6fr) minmax(0,5fr);gap:var(--s5);align-items:start}
.L .offer h2{color:#F7F6F3;font-size:clamp(34px,4vw,60px);line-height:1.15}
.L .offer .kick{color:#9EA1A8}.L .offer .kick:before{background:#EDEBE6}.L .offer .kick .mono{color:#EDEBE6}
.L .offer ol{list-style:none;padding:0;margin:var(--s4) 0 0;border-top:1px solid #3A3C42}
.L .offer ol li{display:grid;grid-template-columns:44px 1fr auto;gap:12px;padding:14px 0;border-bottom:1px solid #2C2E33;font-size:16px;align-items:baseline}
.L .offer ol .mono{font-size:13px;color:#9EA1A8}
.L .offer ol .f{font-family:"AMono";font-size:12px;color:#9EA1A8;direction:ltr}
.L .card{background:#F7F6F3;color:var(--ink);padding:var(--s4);position:sticky;top:96px}
.L .card .pr{font-family:"AMarkazi";font-weight:700;font-size:76px;line-height:1;display:flex;align-items:baseline;gap:14px}
.L .card .pr small{font-family:"APlex";font-size:15px;font-weight:400;color:var(--ink2)}
.L .card .btn{width:100%;justify-content:center;margin-top:var(--s3)}
.L .card dl{margin:var(--s3) 0 0;font-size:14.5px}
.L .card dl div{display:grid;grid-template-columns:110px 1fr;gap:12px;padding:10px 0;border-top:1px solid var(--rule)}
.L .card dt{color:var(--mute)}
.L .card dd{margin:0;color:var(--ink)}
.L .card .alt{font-size:13.5px;color:var(--ink2);margin-top:var(--s2)}
/* ---------- faq ---------- */
.L .faq{padding:var(--s6) 0}
.L .faq .g{display:grid;grid-template-columns:minmax(0,4fr) minmax(0,8fr);gap:var(--s5)}
.L .faq h2{font-size:clamp(28px,3vw,44px)}
.L details{border-top:1px solid var(--rule);padding:18px 0}
.L details:last-child{border-bottom:1px solid var(--rule)}
.L summary{list-style:none;cursor:pointer;font-weight:600;font-size:17px;display:flex;justify-content:space-between;gap:18px}
.L summary::-webkit-details-marker{display:none}
.L summary:after{content:"+";font-family:"AMono";color:var(--mute)}
.L details[open] summary:after{content:"−"}
.L details p{margin:10px 0 0;color:var(--ink2);font-size:16px}
/* ---------- footer ---------- */
.L .foot{border-top:1px solid var(--ink);padding:var(--s4) 0 var(--s5);font-size:13.5px;color:var(--mute)}
.L .foot .g{display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px 32px}
.L .foot a{color:var(--ink2)}
/* ---------- sticky mobile buy ---------- */
.L .sbar{position:fixed;inset:auto 0 0 0;z-index:50;background:rgba(18,19,23,.97);color:#EDEBE6;display:none;align-items:center;justify-content:space-between;gap:14px;padding:12px 18px calc(12px + env(safe-area-inset-bottom));transform:translateY(110%);transition:transform .35s ease}
.L .sbar.on{transform:none}
.L .sbar b{font-family:"AMarkazi";font-size:26px;color:#fff}
.L .sbar span{display:block;font-size:12px;color:#9EA1A8}
.L .sbar .btn{height:46px;padding:0 20px;background:#F7F6F3;color:var(--ink);font-size:15.5px}
/* ---------- motion ---------- */
.L [data-rv]{opacity:0;transform:translateY(14px);transition:opacity .7s cubic-bezier(.2,.7,.2,1),transform .7s cubic-bezier(.2,.7,.2,1)}
.L [data-rv].in{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){.L [data-rv]{opacity:1;transform:none;transition:none}}
/* ---------- tablet ---------- */
@media (max-width:1100px){
 .L .hero{grid-template-columns:1fr;max-height:none;min-height:0}
 .L .hero .txt{padding:var(--s5) var(--side) var(--s4);margin:0;max-width:760px}
 .L .hero .img{aspect-ratio:1/1;max-height:none;min-height:0}
 .L .tgrid,.L .compare,.L .pub .g,.L .faq .g,.L .offer .g,.L .reveal .head{grid-template-columns:1fr;gap:var(--s4)}
 .L .steps{grid-template-columns:repeat(2,minmax(0,1fr))}
