   '<div class="rq"><div class="bar"><span>الطلب الجاهز · سير العمل '+String(i+1).padStart(2,'0')+'</span><span>من المكتبة كما هو</span></div>'+
   d.req.map(function(r){return '<div>'+(r[0]?'<span class="m">'+esc(r[0])+':</span>':'')+phs(r[1])+'</div>'}).join('')+'</div>'+
   '<ul class="vf">'+d.v.map(function(v){return '<li>'+esc(v)+'</li>'}).join('')+'</ul>';}
 data.forEach(function(d,i){var b=document.createElement('button');b.setAttribute('role','tab');b.innerHTML='<span class="mono">'+String(i+1).padStart(2,'0')+'</span><span>'+esc(d.t)+'</span>';b.addEventListener('click',function(){show(i)});var li=document.createElement('li');li.appendChild(b);list.appendChild(li);
  var o=document.createElement('option');o.value=i;o.textContent=String(i+1).padStart(2,'0')+' · '+d.t;sel.appendChild(o);});
 sel.addEventListener('change',function(){show(+sel.value)}); show(0);
 /* sticky bar */
 var sb=root.querySelector('.sbar'),off=root.querySelector('#offer');
 function st(){var o=off.getBoundingClientRect();sb.classList.toggle('on',(window.scrollY||0)>700&&!(o.top<innerHeight&&o.bottom>0));}
 addEventListener('scroll',st,{passive:true}); st();
 /* price + purchase: real product only */
 var h=root.getAttribute('data-handle'),R=(window.Shopify&&Shopify.routes&&Shopify.routes.root)||'/';
 function preview(){root.classList.add('is-preview');root.querySelectorAll('.js-buy').forEach(function(b){b.setAttribute('aria-disabled','true');b.innerHTML='الشراء متاح بعد النشر';b.addEventListener('click',function(e){e.preventDefault()})});}
 if(!h){preview();return;}
 fetch(R+'products/'+encodeURIComponent(h)+'.js',{credentials:'same-origin'}).then(function(r){if(!r.ok)throw 0;return r.json()}).then(function(p){
  var v=p.variants&&p.variants[0]; if(!v||!v.available) throw 0;
  var cur=(window.Shopify&&Shopify.currency&&Shopify.currency.active)||'USD',t;
  try{t=new Intl.NumberFormat('en',{style:'currency',currency:cur,maximumFractionDigits:0}).format(v.price/100)}catch(e){t='$'+v.price/100}
  root.querySelectorAll('.js-price').forEach(function(s){s.textContent=t});
  root.querySelectorAll('.js-buy').forEach(function(b){b.href=R+'cart/'+v.id+':1'});
 }).catch(preview);
})();
