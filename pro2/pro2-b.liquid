<style>
@font-face{font-family:"BAlex";font-weight:700;src:url("{{ 'pro2-alex-700.woff2' | asset_url }}") format("woff2")}
@font-face{font-family:"BAlex";font-weight:300;src:url("{{ 'pro2-alex-300.woff2' | asset_url }}") format("woff2")}
@font-face{font-family:"BPlex";font-weight:400;src:url("{{ 'pro-plex-400.woff2' | asset_url }}") format("woff2")}
@font-face{font-family:"BPlex";font-weight:600;src:url("{{ 'pro-plex-600.woff2' | asset_url }}") format("woff2")}
@font-face{font-family:"BPlex";font-weight:400;unicode-range:U+0000-00FF;src:url("{{ 'pro-plexl-400.woff2' | asset_url }}") format("woff2")}
.B{--bg:#0E1014;--bg2:#15181E;--tx:#E9ECF1;--tx2:#9AA3B2;--ln:#262B33;--acc:#A9C1E2;direction:rtl;background:var(--bg);color:var(--tx);font-family:"BPlex",sans-serif;font-size:18px;line-height:1.85}
.B *{box-sizing:border-box}.B img{display:block;max-width:100%;height:auto}
.B h1,.B h2{font-family:"BAlex";font-weight:700;margin:0;color:#fff;letter-spacing:0}
.B .w{max-width:1240px;margin:0 auto;padding:0 clamp(20px,4vw,56px)}
.B .nav{height:64px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--ln)}
.B .nav b{font-weight:600}.B .nav a{color:var(--tx);text-decoration:none;font-size:14px;border:1px solid #3A414D;padding:8px 16px;border-radius:999px}
.B .hero{text-align:center;padding:96px 0 0}
.B .ey{font-size:14px;color:var(--acc);letter-spacing:.02em}
.B .hero h1{font-size:clamp(40px,5.6vw,84px);line-height:1.15;margin:18px auto 0;max-width:15ch}
.B .hero p{color:var(--tx2);max-width:640px;margin:26px auto 34px;font-size:19px}
.B .cta{display:inline-flex;gap:12px;align-items:center;background:#fff;color:#0E1014;font-weight:600;text-decoration:none;padding:16px 32px;border-radius:999px}
.B .cta2{color:var(--acc);text-decoration:none;margin-right:22px;font-weight:600}
.B .hero figure{margin:56px 0 0}
.B .sec{padding:120px 0;border-top:1px solid var(--ln)}
.B .sec h2{font-size:clamp(34px,4vw,60px);line-height:1.2;max-width:18ch}
.B .two{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center;margin-top:48px}
.B .q{background:var(--bg2);border:1px solid var(--ln);border-radius:20px;padding:32px;font-size:19px;line-height:2.2;color:#C9D0DA}
.B .q u{text-decoration:none;border-bottom:2px solid #E5775F}
.B .q small{display:block;font-size:13px;color:var(--tx2);margin-bottom:12px}
.B .ans{background:#F1F3F6;color:#0E1014;border-radius:20px;padding:32px;font-size:16.5px;line-height:1.9}
.B .ans b{font-family:"BAlex";display:block;font-size:18px;margin-top:8px}
.B .ok{display:inline-block;margin-top:14px;color:#1F6E52;font-weight:600;font-size:13px}
.B .big{text-align:center}
.B .big h2{margin:0 auto}
.B .big p{color:var(--tx2);max-width:620px;margin:22px auto 0}
.B .grid8{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--ln);margin-top:56px;border:1px solid var(--ln);border-radius:16px;overflow:hidden}
.B .grid8 div{background:var(--bg);padding:24px;font-size:15px;color:var(--tx2)}
.B .grid8 b{display:block;color:#fff;font-family:"BAlex";font-size:19px;margin:6px 0}
.B .grid8 span{font-size:12.5px;color:var(--acc)}
.B .offer{text-align:center}
.B .price{font-family:"BAlex";font-size:96px;color:#fff;line-height:1;margin:28px 0 8px}
.B .rib{background:#7A2E26;color:#fff;font-size:13px;text-align:center;padding:7px}
@media(max-width:800px){.B .two{grid-template-columns:1fr}.B .grid8{grid-template-columns:1fr 1fr}.B .cta2{display:block;margin:18px 0 0}.B .sec{padding:80px 0}.B .hero{padding-top:56px}}
</style>
<div class="B">
<div class="rib">مفهوم بديل للمقارنة · غير منشور</div>
<div class="w nav"><b>AI Step Ahead</b><a href="#o">الإصدار المهني · <span dir="ltr">$79</span></a></div>
