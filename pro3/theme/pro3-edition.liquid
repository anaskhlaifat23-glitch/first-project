 var sb=root.querySelector('.sbar'),off=root.querySelector('#offer');
 function st(){var o=off.getBoundingClientRect();sb.classList.toggle('on',(window.scrollY||0)>700&&!(o.top<innerHeight&&o.bottom>0))}
 addEventListener('scroll',st,{passive:true});st();

