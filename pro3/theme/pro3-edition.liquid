 var A=root.getAttribute('data-assets')||'';
 var ring=root.querySelector('#ring'),info=root.querySelector('#sinfo'),shelf=root.querySelector('.shelf'),sel=-1,focus=0;
 var srcs=JSON.parse(document.getElementById('shelfsrc').textContent);
 K.forEach(function(k,i){var b=document.createElement('button');b.className='bk';b.type='button';b.setAttribute('role','listitem');b.setAttribute('aria-label',k[0]+' · '+k[1]+' · اقلب لرؤية صفحة من الداخل');
  b.innerHTML='<span class="f"><img src="'+srcs.c[i]+'" alt="" width="220" height="311" loading="lazy"></span><span class="b"><img src="'+srcs.p[i]+'" alt="صفحة من داخل '+esc(k[1])+'" width="220" height="311" loading="lazy"></span>';
  b.addEventListener('click',function(){ if(MOB){ b.classList.toggle('flip'); show(i,true); return;} if(sel===i){ back(); } else { select(i);} });
  ring.appendChild(b)});
 var bks=ring.querySelectorAll('.bk');
 function layout(){ if(MOB) return; var n=bks.length;
  bks.forEach(function(b,i){var d=i-focus; var ang=d*13, x=d*168, z=-Math.abs(d)*90, op=Math.abs(d)>4?0:1;
   if(sel>=0){ if(i===sel){ b.style.transform='translate3d(0,-10px,260px) rotateY(180deg) scale(1.18)'; b.style.opacity=1; b.style.zIndex=20; return;} op=.18; }
   b.style.transform='translate3d('+(-x)+'px,0,'+z+'px) rotateY('+(ang)+'deg)'; b.style.opacity=op; b.style.zIndex=10-Math.abs(d);});}
 function show(i,mob){var k=K[i]; info.innerHTML='<span class="mono">'+k[0]+' / 07</span><h3>'+esc(k[1])+'</h3><p>'+esc(k[2])+'</p><div class="spec">'+esc(k[3])+'</div>'+(mob?'':'<div class="acts"><button type="button" class="pri" data-a="b">عودة إلى المجموعة</button><button type="button" data-a="p">→ السابق</button><button type="button" data-a="n">التالي ←</button></div>');
  shelf.classList.add('sel'); info.querySelectorAll('button').forEach(function(bt){bt.addEventListener('click',function(){var a=bt.dataset.a; if(a==='b')back(); if(a==='n')select((sel+1)%8); if(a==='p')select((sel+7)%8);})});}
 function select(i){sel=i;focus=i;layout();show(i)}
 function back(){sel=-1;shelf.classList.remove('sel');layout()}
