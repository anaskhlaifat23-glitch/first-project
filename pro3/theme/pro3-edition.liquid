   (fixed[i]?'<dt>الصيغة بعد التحقّق</dt><dd class="fix">'+esc(x.neu)+'</dd>':'')+'</dl>'+
   '<div class="acts">'+(fixed[i]?'':'<button class="btn" type="button" data-a="fix">طبّق التصحيح</button>')+(i<4?'<button class="btn ghost" type="button" data-a="next">المشكلة التالية</button>':'')+'</div>';
  panel.querySelectorAll('[data-a]').forEach(function(b){b.addEventListener('click',function(){ if(b.dataset.a==='fix') apply(i); else open(nextOpen(i)); })});
  go.innerHTML=fixed[i]?'المشكلة التالية <span class="ar">←</span>':'طبّق التصحيح <span class="ar">←</span>'; go.dataset.mode=fixed[i]?'next':'fix';
