 if(!h){preview();return}
 fetch(R+'products/'+encodeURIComponent(h)+'.js',{credentials:'same-origin'}).then(function(r){if(!r.ok)throw 0;return r.json()}).then(function(p){var v=p.variants&&p.variants[0];if(!v||!v.available)throw 0;var cur=(window.Shopify&&Shopify.currency&&Shopify.currency.active)||'USD',t;try{t=new Intl.NumberFormat('en',{style:'currency',currency:cur,maximumFractionDigits:0}).format(v.price/100)}catch(e){t='$'+v.price/100}root.querySelectorAll('.js-price').forEach(function(s){s.textContent=t});root.querySelectorAll('.js-buy').forEach(function(b){b.href=R+'cart/'+v.id+':1'})}).catch(preview);
});
