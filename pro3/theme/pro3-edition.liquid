 root.querySelector('#s3d').addEventListener('keydown',function(e){ if(e.key==='ArrowLeft'){root.querySelector('#snext').click();e.preventDefault()} if(e.key==='ArrowRight'){root.querySelector('#sprev').click();e.preventDefault()} if(e.key==='Escape'){back()} });
