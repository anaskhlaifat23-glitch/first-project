 function nextOpen(i){for(var k=1;k<=5;k++){var j=(i+k)%5;if(!fixed[j])return j}return (i+1)%5}
 function apply(i){var s=dr.querySelector('.is[data-i="'+i+'"]'); if(!s||fixed[i]||busy) return; var g=gen; busy=true;
  s.classList.add('striking'); setTimeout(function(){busy=false; if(g!==gen) return; s.classList.remove('striking');s.classList.add('fixed');fixed[i]=true;setProg();
   if(fixed.every(Boolean)){ finish(); } else { open(i); }
  },RM?0:650);}
 function finish(){cur=-1;setProg();dr.querySelectorAll('.is').forEach(function(s){s.classList.remove('cur')});
  var g=gen; setTimeout(function(){if(g!==gen) return; doc.classList.add('done');badge.className='badge v';badge.textContent='مذكّرة · تمّ التحقّق';},RM?0:500);
  panel.classList.remove('fade'); void panel.offsetWidth; panel.classList.add('fade');
