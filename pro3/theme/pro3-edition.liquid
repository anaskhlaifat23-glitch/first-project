<style>
@font-face{font-family:"VK";font-weight:600;font-display:swap;src:url("{{ 'pro2-markazi-600.woff2' | asset_url }}") format("woff2")}
@font-face{font-family:"VK";font-weight:700;font-display:swap;src:url("{{ 'pro2-markazi-700.woff2' | asset_url }}") format("woff2")}
@font-face{font-family:"VK";font-weight:600;font-display:swap;unicode-range:U+0000-00FF;src:url("{{ 'pro2-markazil-600.woff2' | asset_url }}") format("woff2")}
@font-face{font-family:"VP";font-weight:400;font-display:swap;src:url("{{ 'pro-plex-400.woff2' | asset_url }}") format("woff2")}
@font-face{font-family:"VP";font-weight:600;font-display:swap;src:url("{{ 'pro-plex-600.woff2' | asset_url }}") format("woff2")}
@font-face{font-family:"VP";font-weight:400;font-display:swap;unicode-range:U+0000-00FF,U+2000-206F,U+2190-21FF,U+2713;src:url("{{ 'pro-plexl-400.woff2' | asset_url }}") format("woff2")}
@font-face{font-family:"VP";font-weight:600;font-display:swap;unicode-range:U+0000-00FF,U+2000-206F,U+2190-21FF,U+2713;src:url("{{ 'pro-plexl-600.woff2' | asset_url }}") format("woff2")}
@font-face{font-family:"VM";font-weight:400;font-display:swap;src:url("{{ 'pro2-mono-400.woff2' | asset_url }}") format("woff2")}

/* ================= DESIGN SYSTEM =================
 colour: paper #F7F6F3 · stone #ECE9E3 · ink #121317 · ink-2 #474B54 · mute #6B6E75 · rule #D9D6CF · red (unverified) #B42318 · green (verified) #1F5E46
 type: display VK (Markazi Text) 600/700 · body VP (IBM Plex Sans Arabic) 400/600 · figures VM (Plex Mono)
 scale: 13 · 15 · 17/18 · 22 · 28 · clamp(32→56) · clamp(40→84)
 space: 8 · 16 · 24 · 40 · 64 · 104 · 160    grid: 1320 max, 12 col, side clamp(20px,4vw,56px)
 motion: 600–900ms cubic-bezier(.2,.7,.2,1); only to explain state; prefers-reduced-motion = no motion
=================================================== */
.V{--paper:#F7F6F3;--stone:#ECE9E3;--ink:#121317;--ink2:#474B54;--mute:#6B6E75;--rule:#D9D6CF;--red:#B42318;--green:#1F5E46;--amber:#A86A12;
 --side:clamp(20px,4vw,56px);--wrap:1320px;--ease:cubic-bezier(.2,.7,.2,1);
 direction:rtl;background:var(--paper);color:var(--ink);font-family:"VP",system-ui,sans-serif;font-size:18px;line-height:1.85;-webkit-font-smoothing:antialiased}
.V *{box-sizing:border-box}
.V img,.V video{display:block;max-width:100%;height:auto}
.V a{color:inherit}
.V p{margin:0 0 16px}
.V h1,.V h2,.V h3,.V h4{font-family:"VK",serif;font-weight:700;margin:0;color:var(--ink);letter-spacing:0}
.V .mono{font-family:"VM",ui-monospace,monospace;direction:ltr;unicode-bidi:isolate;letter-spacing:.02em}
.V .en{direction:ltr;unicode-bidi:isolate}
.V .wrap{max-width:var(--wrap);margin:0 auto;padding:0 var(--side)}
.V .kick{font-size:13px;color:var(--mute);display:flex;gap:12px;align-items:center;margin-bottom:22px}
.V .kick:before{content:"";width:28px;height:1px;background:currentColor}
.V .kick .mono{color:var(--ink)}
.V .btn{display:inline-flex;align-items:center;justify-content:center;gap:14px;min-height:56px;padding:0 30px;background:var(--ink);color:#F7F6F3;text-decoration:none;font:600 17px/1 "VP",sans-serif;border:0;border-radius:2px;cursor:pointer;transition:background .25s,transform .25s var(--ease)}
.V .btn:hover{background:#2a2c33}
.V .btn.light{background:#F7F6F3;color:var(--ink)}
.V .btn.light:hover{background:#fff}
.V .btn.ghost{background:transparent;color:var(--ink);box-shadow:inset 0 0 0 1px var(--ink)}
.V .btn .ar{transition:transform .25s var(--ease)}.V .btn:hover .ar{transform:translateX(-4px)}
.V .btn[aria-disabled=true]{opacity:.55;cursor:not-allowed}
.V :focus-visible{outline:2px solid var(--red);outline-offset:3px}
.V .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

/* ---------- dev pill (preview only) ---------- */
.V .dev{position:fixed;left:14px;bottom:14px;z-index:90;display:none;align-items:center;gap:8px;background:rgba(18,19,23,.86);color:#E8E6E1;font-size:12px;padding:6px 12px;border-radius:999px;backdrop-filter:blur(6px)}
.V .dev i{width:7px;height:7px;border-radius:50%;background:#E0A93A;display:inline-block}
.V.is-preview .dev{display:flex}

/* ---------- masthead ---------- */
.V .mast{position:absolute;top:0;right:0;left:0;z-index:30}
.V .mast .wrap{height:72px;display:flex;align-items:center;justify-content:space-between}
.V .brand{font-weight:600;font-size:15px}
.V .brand small{font-weight:400;color:var(--ink2);margin-right:10px}
.V .mast nav{display:flex;gap:26px;font-size:14.5px}
.V .mast nav a{text-decoration:none;color:var(--ink2)}
.V .mast nav a:hover{color:var(--ink)}
.V .mast .pill{text-decoration:none;font-size:14px;font-weight:600;background:var(--ink);color:#fff;padding:9px 18px;border-radius:2px}

/* ---------- hero ---------- */
.V .hero{position:relative;height:min(100vh,56.25vw);min-height:640px;max-height:1000px;overflow:hidden;background:#D9D2C6}
.V .hero .media{position:absolute;inset:0}
.V .hero .media img,.V .hero .media video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:0% 50%}
.V .hero .media video{opacity:0;transition:opacity .8s var(--ease)}
.V .hero .media video.on{opacity:1}
.V .hero .veil{position:absolute;inset:0;background:linear-gradient(270deg,rgba(232,228,221,.78) 0%,rgba(232,228,221,.55) 28%,rgba(232,228,221,0) 46%)}
.V .hero .copy{position:absolute;top:0;bottom:0;right:var(--side);width:min(500px,36vw);display:flex;flex-direction:column;justify-content:center;padding-top:40px;margin-right:max(0px,calc((100vw - var(--wrap))/2))}
.V .hero h1{font-size:clamp(36px,3.5vw,58px);line-height:1.22}
.V .hero h1 span{display:block;color:var(--ink2);font-weight:600}
.V .hero .sub{font-size:clamp(16.5px,1.25vw,19px);color:var(--ink2);margin:26px 0 30px}
.V .hero .row{display:flex;flex-wrap:wrap;gap:14px;align-items:center}
.V .hero .fmt{margin-top:20px;font-size:13.5px;color:var(--ink2);display:flex;flex-wrap:wrap;gap:4px 16px}
.V .hero .fmt b{font-weight:600;color:var(--ink)}
.V .hero .ctl{position:absolute;left:var(--side);bottom:22px;z-index:3;font-size:12.5px;color:var(--ink2);background:rgba(247,246,243,.75);border:0;border-radius:999px;padding:6px 12px;cursor:pointer;font-family:"VP"}
.V .hero .cap{position:absolute;left:var(--side);bottom:62px;font-size:12px;color:#6B655B}

/* ---------- identity ---------- */
.V .ident{padding:140px 0 120px}
.V .ident h2{font-size:clamp(36px,4.6vw,72px);line-height:1.18;max-width:16ch}
.V .ident h2 em{font-style:normal;color:var(--red)}
.V .times{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin-top:72px;border-top:1px solid var(--ink)}
.V .times div{padding:24px 0 0 32px}
.V .times div+div{padding-right:32px;border-right:1px solid var(--rule)}
.V .times .mono{font-size:15px;display:block;margin-bottom:10px}
.V .times p{font-size:16.5px;color:var(--ink2);margin:0;line-height:1.8}

/* ---------- verification experience ---------- */
.V .vx{background:var(--stone);padding:120px 0}
.V .vx h2{font-size:clamp(32px,3.8vw,56px);line-height:1.2;max-width:26ch}
.V .vx .lead{color:var(--ink2);max-width:640px;margin-top:22px}
.V .vxg{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:40px;margin-top:56px;align-items:start}
.V .doc{background:#fff;border:1px solid var(--rule);box-shadow:0 50px 70px -50px rgba(40,30,15,.45);position:relative;overflow:hidden}
.V .doc .bar{display:flex;justify-content:space-between;align-items:center;padding:12px 22px;border-bottom:1px solid var(--rule);font-size:12.5px;color:var(--mute);background:#FBFAF8}
.V .doc .bar .mono{font-size:11.5px}
.V .badge{font-weight:600;font-size:12.5px;padding:3px 10px;border-radius:2px;transition:background .4s,color .4s}
.V .badge.u{background:#F6E3E0;color:var(--red)}
.V .badge.v{background:#E3EEE8;color:var(--green)}
.V .doc .body{padding:34px 40px 30px;position:relative;min-height:430px}
.V .doc h3{font-size:30px;margin-bottom:4px}
.V .doc .meta{font-size:13px;color:var(--mute);margin-bottom:22px;display:flex;justify-content:space-between;border-bottom:1px solid var(--rule);padding-bottom:10px}
.V .dr{font-size:clamp(17px,1.45vw,20px);line-height:2.35}
.V .is{cursor:pointer;border-radius:2px;background:linear-gradient(transparent 62%,rgba(180,35,24,.10) 62%);border-bottom:2px dotted rgba(180,35,24,.55);transition:background .4s,border-color .4s,color .4s;padding:0 1px}
.V .is .n{font-family:"VM";font-size:10.5px;color:#fff;background:var(--red);border-radius:50%;display:inline-block;width:18px;height:18px;line-height:18px;text-align:center;vertical-align:super;margin-right:3px;transition:background .4s}
.V .is.cur{background:rgba(180,35,24,.16);border-bottom:2px solid var(--red)}
.V .is .old{display:inline}
.V .is .new{display:none;color:var(--green)}
.V .is.fixed{background:linear-gradient(transparent 62%,rgba(31,94,70,.10) 62%);border-bottom:2px solid var(--green)}
.V .is.fixed .n{background:var(--green)}
.V .is.fixed .old{display:none}.V .is.fixed .new{display:inline}
.V .is.striking .old{text-decoration:line-through;text-decoration-color:var(--red);text-decoration-thickness:2px;opacity:.55}
.V .memo{position:absolute;inset:0;padding:34px 40px 30px;background:#fff;opacity:0;visibility:hidden;transform:translateY(12px);transition:opacity .7s var(--ease),transform .7s var(--ease),visibility .7s}
.V .doc.done .memo{opacity:1;visibility:visible;transform:none}
.V .doc.done .body > h3,.V .doc.done .body > .meta,.V .doc.done .dr{display:none}
.V .doc.done .memo{position:relative;padding:0}
.V .memo h4{font-size:22px;margin:16px 0 2px}
.V .memo p{font-size:16.5px;color:#2a2c32;margin:0;line-height:1.85}
.V .stamp{display:inline-block;margin-top:20px;border:1.5px solid var(--green);color:var(--green);font-weight:600;font-size:14px;padding:4px 14px;transform:rotate(-2deg)}
.V .ctrl{display:flex;justify-content:space-between;align-items:center;padding:16px 22px;border-top:1px solid var(--rule);background:#FBFAF8;gap:12px}
.V .prog{display:flex;gap:6px}
.V .prog i{width:26px;height:4px;background:var(--rule);transition:background .4s}
.V .prog i.on{background:var(--red)}.V .prog i.ok{background:var(--green)}
.V .panel{background:var(--paper);border-top:2px solid var(--ink);padding:28px 30px 26px;min-height:430px;position:relative}
.V .panel .step{font-size:13px;color:var(--mute);display:flex;justify-content:space-between}
.V .panel h4{font-size:28px;margin:8px 0 18px;line-height:1.3}
.V .panel h4 .ty{display:block;font-family:"VP";font-size:13px;font-weight:600;color:var(--red);margin-bottom:6px}
.V .panel dl{margin:0}
.V .panel dt{font-size:12.5px;font-weight:600;color:var(--mute);margin-top:14px}
.V .panel dd{margin:4px 0 0;font-size:16px;line-height:1.75;color:var(--ink2)}
.V .panel dd.fix{color:var(--green);font-weight:600}
.V .panel .acts{display:flex;gap:10px;margin-top:24px;flex-wrap:wrap}
.V .panel .acts .btn{min-height:48px;padding:0 20px;font-size:15.5px}
.V .panel.fade{animation:vxin .5s var(--ease)}
@keyframes vxin{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.V .panel .intro p{color:var(--ink2);font-size:16.5px}
.V .panel .intro ol{padding-right:18px;margin:12px 0 0;color:var(--ink2);font-size:15.5px}
.V .vx .note{font-size:13px;color:var(--mute);margin-top:16px}

/* ---------- scroll story ---------- */
.V .story{position:relative;background:var(--paper)}
.V .story .pin{min-height:100vh;display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:56px;align-items:center;max-width:var(--wrap);margin:0 auto;padding:110px var(--side)}
.V .story h2{font-size:clamp(32px,3.6vw,54px);line-height:1.2}
.V .story .rail{margin-top:36px;border-top:1px solid var(--ink)}
.V .story .rail div{display:grid;grid-template-columns:56px 1fr;gap:12px;padding:16px 0;border-bottom:1px solid var(--rule);color:var(--mute);transition:color .4s}
.V .story .rail div b{display:block;font-family:"VK";font-size:22px;color:inherit}
.V .story .rail div span{font-size:15px;line-height:1.7}
.V .story .rail div.on{color:var(--ink)}
.V .story .rail div.on .mono{color:var(--red)}
.V .stage{position:relative;aspect-ratio:4/3.1;background:var(--stone);overflow:hidden}
.V .card{position:absolute;inset:7% 9%;background:#fff;border:1px solid var(--rule);box-shadow:0 40px 60px -40px rgba(40,30,15,.45);padding:28px 32px;font-size:15px;line-height:1.8;opacity:0;transform:translateY(24px) scale(.98)}
.V .card:first-child{opacity:1;transform:none}
.V .card h5{font-family:"VK";font-size:22px;margin:0 0 12px;display:flex;justify-content:space-between;align-items:baseline}
.V .card h5 .mono{font-size:12px;color:var(--mute);font-family:"VM"}
.V table.fig{width:100%;border-collapse:collapse;font-size:14.5px}
.V table.fig td{padding:7px 0;border-bottom:1px solid #EEE}
.V table.fig td.n{font-family:"VM";direction:ltr;text-align:left;font-size:13.5px}
.V table.fig tr.t td{font-weight:600;border-top:1px solid var(--ink);border-bottom:1px solid var(--ink)}
.V .neg{color:var(--red)}.V .pos{color:var(--green)}
.V .card.req{background:var(--ink);color:#E8E6E1;border-color:var(--ink)}
.V .card.req h5{color:#fff}.V .card.req .m{color:#E9B8B2;font-weight:600}.V .card.req .ph{background:#33353B;color:#F3D9A8;padding:0 4px}
.V .card .lg{display:grid;grid-template-columns:1fr auto;gap:10px;padding:7px 0;border-bottom:1px solid #EEE}
.V .card .lg .ok{color:var(--green);font-weight:600;white-space:nowrap}
.V .card h6{font-family:"VK";font-size:18px;margin:12px 0 0}

/* ---------- method ---------- */
.V .method{padding:120px 0;border-top:1px solid var(--ink);background:var(--paper)}
.V .chain{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin-top:40px}
.V .chain > div{padding:0 0 0 36px}
.V .chain > div+div{padding-right:36px;border-right:1px solid var(--rule)}
.V .chain .big{font-family:"VK";font-weight:700;font-size:clamp(40px,4.4vw,68px);line-height:1}
.V .chain p{font-size:16px;color:var(--ink2);margin:14px 0 0;max-width:32ch}
.V .chain .tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:16px}
.V .chain .tags span{font-size:13px;border:1px solid var(--ink);padding:2px 10px}
.V .risk{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin-top:56px}
.V .risk div{border-top:4px solid;padding:14px 0 0 24px;font-size:15px;color:var(--ink2)}
.V .risk b{display:block;color:var(--ink);font-weight:600}

/* ---------- 3D shelf ---------- */
.V .shelf{position:relative;padding:120px 0 110px;background:#E3DED5;overflow:hidden}
.V .shelf:before{content:"";position:absolute;inset:0;background:url("{{ 'pro3-plate-w.webp' | asset_url }}") center/cover;opacity:.55}
.V .shelf .wrap{position:relative}
.V .shelf h2{font-size:clamp(40px,5vw,80px);line-height:1.08}
.V .shelf .lead{color:var(--ink2);max-width:560px;margin-top:20px}
.V .stage3d{position:relative;height:520px;margin-top:40px;perspective:1600px;perspective-origin:50% 35%}
.V .ring{position:absolute;inset:0;transform-style:preserve-3d;pointer-events:none}
.V .bk{pointer-events:auto}
.V .bk{position:absolute;top:40px;left:50%;width:220px;height:311px;margin-left:-110px;transform-style:preserve-3d;transition:transform .9s var(--ease),opacity .6s;cursor:pointer;border:0;padding:0;background:none}
.V .bk .f,.V .bk .b{position:absolute;inset:0;backface-visibility:hidden;-webkit-backface-visibility:hidden;border-radius:2px;overflow:hidden;box-shadow:0 30px 40px -18px rgba(40,30,15,.55),0 2px 6px rgba(40,30,15,.2)}
.V .bk .b{transform:rotateY(180deg);background:#fff}
.V .bk img{width:100%;height:100%;object-fit:cover}
.V .bk:focus-visible{outline:none}.V .bk:focus-visible .f{outline:3px solid var(--red);outline-offset:4px}
.V .shelf .info{position:absolute;inset:auto 0 0 auto;width:min(420px,40%);background:rgba(247,246,243,.96);border-top:2px solid var(--ink);padding:24px 26px;opacity:0;transform:translateY(16px);transition:opacity .6s var(--ease),transform .6s var(--ease);pointer-events:none}
.V .shelf.sel .info{opacity:1;transform:none;pointer-events:auto}
.V .info .mono{font-size:13px;color:var(--mute)}
.V .info h3{font-size:30px;margin:6px 0 8px;line-height:1.25}
.V .info p{font-size:15.5px;color:var(--ink2);margin:0 0 10px}
.V .info .spec{font-family:"VM";font-size:12.5px;color:var(--ink2);direction:ltr;text-align:right}
.V .info .acts{display:flex;gap:10px;margin-top:16px;flex-wrap:wrap}
.V .info .acts button{font:600 14px "VP";border:1px solid var(--ink);background:transparent;padding:8px 14px;cursor:pointer;border-radius:2px;color:var(--ink)}
.V .info .acts button.pri{background:var(--ink);color:#fff}
.V .shelf .hint{position:relative;margin-top:14px;font-size:13.5px;color:var(--ink2);display:flex;gap:18px;flex-wrap:wrap;align-items:center}
.V .shelf .navb{display:flex;gap:8px}
.V .shelf .navb button{width:44px;height:44px;border:1px solid var(--ink);background:rgba(247,246,243,.7);cursor:pointer;font-size:18px;border-radius:2px;color:var(--ink)}
.V .why{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:56px;margin-top:80px;align-items:start;position:relative}
.V .why h3{font-size:clamp(26px,2.6vw,38px);line-height:1.3}
.V .why p{color:var(--ink2);font-size:16.5px}
.V table.cmp{width:100%;border-collapse:collapse;font-size:15px;background:rgba(255,255,255,.92)}
.V table.cmp th{font-weight:600;text-align:right;padding:14px 16px;border-bottom:1px solid var(--ink);font-size:14px}
.V table.cmp th:nth-child(3){background:var(--ink);color:#fff}
.V table.cmp td{padding:12px 16px;border-bottom:1px solid var(--rule)}
.V table.cmp td:nth-child(2),.V table.cmp td:nth-child(3),.V table.cmp th:nth-child(2),.V table.cmp th:nth-child(3){text-align:center;width:22%}
.V .y{color:var(--green);font-weight:600}.V .x{color:#AEB0B5}

/* ---------- explorer ---------- */
.V .explore{padding:120px 0}
.V .explore h2{font-size:clamp(32px,3.6vw,54px);line-height:1.2;max-width:20ch}
.V .ex{display:grid;grid-template-columns:minmax(0,4fr) minmax(0,8fr);margin-top:48px;border-top:1px solid var(--ink)}
.V .ex .list{list-style:none;margin:0;padding:0;border-left:1px solid var(--rule)}
.V .ex .list button{all:unset;cursor:pointer;display:grid;grid-template-columns:34px 1fr;gap:10px;width:100%;box-sizing:border-box;padding:12px 0 12px 18px;border-bottom:1px solid var(--rule);font-size:15.5px;color:var(--ink2);line-height:1.5}
.V .ex .list button .mono{font-size:12.5px;color:var(--mute);padding-top:3px}
.V .ex .list button[aria-selected=true]{color:var(--ink);font-weight:600}
.V .ex .list button[aria-selected=true] .mono{color:var(--red)}
.V .ex .list button:focus-visible{outline:2px solid var(--red)}
.V .ex .panel2{padding:32px 48px 32px 0}
.V .ex .panel2 h3{font-size:28px;margin-bottom:6px}
.V .ex .w{color:var(--ink2);font-size:15.5px;margin-bottom:20px}
.V .ex .lv{font-family:"VP";font-size:12.5px;font-weight:600;padding:2px 10px;border-radius:2px;color:#fff;margin-right:8px;vertical-align:middle}
.V .ex .rq{background:var(--ink);color:#E8E6E1;padding:32px;font-size:15.5px;line-height:2}
.V .ex .rq .m{color:#E9B8B2;font-weight:600;margin-left:6px}
.V .ex .rq .ph{background:#33353B;color:#F3D9A8;padding:0 5px}
.V .ex .rq .bar{display:flex;justify-content:space-between;font-size:12.5px;color:#9EA1A8;border-bottom:1px solid #2E3036;padding-bottom:10px;margin-bottom:14px}
.V .ex .vf{list-style:none;padding:0;margin:20px 0 0}
.V .ex .vf li{padding:9px 28px 9px 0;border-bottom:1px solid var(--rule);font-size:15px;color:var(--ink2);position:relative;line-height:1.7}
