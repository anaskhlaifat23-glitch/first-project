 function reset(){gen++;busy=false;fixed=[false,false,false,false,false];cur=-1;doc.classList.remove('done');badge.className='badge u';badge.textContent='مسودّة · لم يُتحقَّق منها';buildDraft();panel.innerHTML=intro;go.innerHTML='ابدأ التحقّق <span class="ar">←</span>';go.dataset.mode='start';setProg();stat.textContent='';}
