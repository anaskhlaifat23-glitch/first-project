   var p=vid.play(); if(p&&p.catch) p.catch(function(){});
  },300)});
  ctl.addEventListener('click',function(){ if(vid.paused){vid.play();ctl.textContent='إيقاف الحركة';ctl.setAttribute('aria-label','إيقاف الفيديو')}else{vid.pause();ctl.textContent='تشغيل الحركة';ctl.setAttribute('aria-label','تشغيل الفيديو')} });
 } else if(ctl){ ctl.remove(); }

 /* ---- VERIFICATION EXPERIENCE ---- */
 var IS=[
  {old:'شهدت الشركة خلال أكتوبر انخفاضًا في الإيرادات بنسبة 8%',neu:'انخفضت الإيرادات في أكتوبر 5.5% (500 ألف ريال) عن الموازنة',ty:'رقم لا يتطابق مع الجدول',why:'أوّل رقم سيعيد مديرك حسابه. خطأ واحد في السطر الأول يُسقط الثقة بالمذكّرة كلّها.',chk:'ك · الكمّ: أعد الحساب من سطر الإجمالي: (8,650 − 9,150) ÷ 9,150 = −5.5%.'},
  {old:'ضعف الطلب في السوق',neu:'تأجيل عميل رئيسي في جدة طلبيات بنحو 300 ألف ريال إلى نوفمبر',ty:'ادّعاء بلا مصدر',why:'سبب مقنع لكنه مخترَع. إن سُئلت عن مصدره فلن تجد جوابًا.',chk:'د · الدليل: ما المصدر المكتوب؟ بريد المبيعات يوثّق تأجيل طلبيات جدة فقط.'},
  {old:'خاصةً في منطقة الدمام',neu:'بينما تجاوزت الدمام الموازنة بـ 5%',ty:'حقيقة معكوسة',why:'يحمّل فريقًا حقّق الموازنة مسؤولية تراجع لم يسبّبه.',chk:'أ · الأصل: سطر الدمام في الجدول: 1,890 مقابل 1,800 (+5.0%).'},
  {old:'ارتفعت المصاريف التشغيلية بشكل ملحوظ',neu:'ارتفعت المصاريف التشغيلية 45 ألفًا (+2.4%)، وأكبر بنودها النقل (+70 ألفًا) بعد رسوم الوقود',ty:'كلام لا يمكن قياسه',why:'«ملحوظ» لا يقول كم ولا أين. القارئ يحتاج الرقم والبند.',chk:'ك · الكمّ: 1,950 مقابل 1,905؛ والنقل 610 مقابل 540 بحسب ملحق عقد النقل.'},
  {old:'ونوصي بتكثيف الجهود التسويقية',neu:'المطلوب قرار قبل دورة نوفمبر بشأن رسوم الوقود: التفاوض عليها أو تحميلها على الأسعار',ty:'توصية غامضة',why:'توصية عامّة لا ترتبط بالأرقام، والتسويق أنفق أقلّ من الموازنة أصلًا.',chk:'المعيار: كلّ توصية تبدأ من فرق في الجدول وتنتهي بقرار محدّد يُطلب من الإدارة.'}
 ];
 var dr=root.querySelector('#vdraft'),doc=root.querySelector('#vdoc'),panel=root.querySelector('#vpanel'),go=root.querySelector('#vgo'),badge=root.querySelector('#vbadge'),prog=root.querySelectorAll('#vprog i'),stat=root.querySelector('#vstat');
 var intro=panel.innerHTML;
 var glue=['، ويعود ذلك إلى ','، ','. كما ','. ','.'];
 function buildDraft(){dr.innerHTML=IS.map(function(x,i){return '<span class="is" data-i="'+i+'" tabindex="0" role="button" aria-label="المشكلة '+(i+1)+'"><span class="old">'+esc(x.old)+'</span><span class="new">'+esc(x.neu)+'</span><span class="n">'+(i+1)+'</span></span>'+esc(glue[i])}).join('');
  dr.querySelectorAll('.is').forEach(function(s){s.addEventListener('click',function(){open(+s.dataset.i)});s.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();open(+s.dataset.i)}})});}
 var cur=-1,fixed=[false,false,false,false,false],gen=0,busy=false;
