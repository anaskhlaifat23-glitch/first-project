 function sh(i){var d=data[i];if(!d)return; list.querySelectorAll('button').forEach(function(b,j){b.setAttribute('aria-selected',j===i?'true':'false')}); sel2.value=i;
  p2.innerHTML='<h3>'+esc(d.t)+'<span class="lv" style="background:'+(col[d.lvc]||col.y)+'">'+esc(d.lvl||'')+'</span></h3><p class="w">'+esc(d.w)+'</p><div class="rq"><div class="bar"><span>الطلب الجاهز · سير العمل '+String(i+1).padStart(2,'0')+'</span><span>من المكتبة كما هو</span></div>'+d.req.map(function(r){return '<div>'+(r[0]?'<span class="m">'+esc(r[0])+':</span>':'')+phs(r[1])+'</div>'}).join('')+'</div><ul class="vf">'+d.v.map(function(v){return '<li>'+esc(v)+'</li>'}).join('')+'</ul>';}
 data.forEach(function(d,i){var b=document.createElement('button');b.setAttribute('role','tab');b.innerHTML='<span class="mono">'+String(i+1).padStart(2,'0')+'</span><span>'+esc(d.t)+'</span>';b.addEventListener('click',function(){sh(i)});var li=document.createElement('li');li.appendChild(b);list.appendChild(li);var o=document.createElement('option');o.value=i;o.textContent=String(i+1).padStart(2,'0')+' · '+d.t;sel2.appendChild(o)});
 sel2.addEventListener('change',function(){sh(+sel2.value)}); sh(0);

 /* ---- scroll story (GSAP ScrollTrigger; static fallback) ---- */
 var cards=root.querySelectorAll('#sstage .card'),rails=root.querySelectorAll('#rail > div');
 function stage(k){cards.forEach(function(c,i){c.style.opacity=i===k?1:0;c.style.transform=i===k?'none':'translateY(24px) scale(.98)';c.style.transition='opacity .6s, transform .6s'});rails.forEach(function(r,i){r.classList.toggle('on',i===k)})}
 if(!RM&&!MOB&&window.gsap&&window.ScrollTrigger){
  gsap.registerPlugin(ScrollTrigger);
  var tl=gsap.timeline({scrollTrigger:{trigger:'#story',start:'top top',end:'+=2400',pin:'#story .pin',scrub:0.6,onUpdate:function(s){var k=Math.min(3,Math.floor(s.progress*4));rails.forEach(function(r,i){r.classList.toggle('on',i===k)})}}});
  for(var i=1;i<4;i++){ tl.to(cards[i-1],{opacity:0,y:-24,scale:.98,duration:1},i-1+0.5).fromTo(cards[i],{opacity:0,y:24,scale:.98},{opacity:1,y:0,scale:1,duration:1},i-1+0.5); }
 } else {
  var k=0; rails.forEach(function(r,i){r.style.cursor='pointer';r.setAttribute('role','button');r.setAttribute('tabindex','0');r.setAttribute('aria-label','المرحلة '+(i+1));r.addEventListener('click',function(){stage(i)});r.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();stage(i)}})});
  if('IntersectionObserver' in window&&!RM){var t2;var io2=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting&&!t2){t2=setInterval(function(){k=(k+1)%4;stage(k)},2600)}else if(!e.isIntersecting&&t2){clearInterval(t2);t2=null}})},{threshold:.4});io2.observe(root.querySelector('#sstage'))}
 }

